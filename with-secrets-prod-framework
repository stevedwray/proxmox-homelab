#!/bin/bash
# with-secrets-prod-framework — production wrapper for the "pve-framework"
# Proxmox node (Framework Desktop).
#
# Thin entrypoint: all the actual logic lives in
# scripts/with-secrets-prod-lib.sh, shared with ./with-secrets-prod. See
# docs/framework-integration/decisions.md Decision 6 for why this is a
# separate wrapper rather than a flag on with-secrets-prod.
#
# Requires .env.pve-framework, the hosts/pve-framework entry in OpenBao, and
# the deploy-pve-framework AppRole credentials in ~/.config/openbao/.
#
# Read-only commands (allowed):
#   ./with-secrets-prod-framework pct list
#   ./with-secrets-prod-framework terraform plan
#
# Mutating commands (requires approval):
#   export TASK_APPROVAL="task-name-from-docs"
#   ./with-secrets-prod-framework terragrunt apply
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="${SCRIPT_DIR}"
export PVE_PROD_NODE="pve-framework"

exec "${SCRIPT_DIR}/scripts/with-secrets-prod-lib.sh" "$@"
