#!/bin/bash
# with-secrets-prod-tiny — production wrapper for the "pve-tiny" Proxmox
# node.
#
# Thin entrypoint: all the actual logic lives in
# scripts/with-secrets-prod-lib.sh, shared with ./with-secrets-prod and
# ./with-secrets-prod-framework. See
# docs/framework-integration/decisions.md Decision 6 for why this is a
# separate wrapper rather than a flag on with-secrets-prod.
#
# Requires terraform/secrets.pve-tiny.enc.yaml and .env.pve-tiny to exist —
# created during host bootstrap once this node has a real Terraform API
# token.
#
# Read-only commands (allowed):
#   ./with-secrets-prod-tiny pct list
#   ./with-secrets-prod-tiny terraform plan
#
# Mutating commands (requires approval):
#   export TASK_APPROVAL="task-name-from-docs"
#   ./with-secrets-prod-tiny terragrunt apply
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="${SCRIPT_DIR}"
export PVE_PROD_NODE="pve-tiny"

exec "${SCRIPT_DIR}/scripts/with-secrets-prod-lib.sh" "$@"
