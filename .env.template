export PROXMOX_HOST="pve.gibbsgreatly.xyz"
export PROXMOX_TOKEN_SECRET=__FROM_BITWARDEN__
export PROXMOX_USER=automation@pve
export PROXMOX_TOKEN_ID='__FROM_BITWARDEN__'
export SERVICE_PASSWORD=__FROM_BITWARDEN__
# ----------------------------------------------------------------
# Proxmox API - Token Auth (For Terraform)
# ----------------------------------------------------------------
# Terraform is configured to use this method exclusively.
# The TF_VAR_ prefix allows Terraform to read these automatically.
export TF_VAR_lxc_password=${SERVICE_PASSWORD}
export TF_VAR_pm_api_token_id=automation@pve!terraform
export TF_VAR_pm_api_token_secret=${PROXMOX_TOKEN_SECRET}
export TF_VAR_proxmox_api_url=https://${PROXMOX_HOST}:8006/api2/json
export TF_VAR_proxmox_node=pve

# ----------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------
export ANSIBLE_PRIVATE_KEY_FILE="~/.ssh/id_rsa"
export ANSIBLE_HOST_KEY_CHECKING=False

# ----------------------------------------------------------------
# External Services (For VSCode Continue.dev)
# ----------------------------------------------------------------
export ANTHROPIC_API_KEY="__FROM_BITWARDEN__"

export PORTAINER_ADMIN_PASSWORD=${SERVICE_PASSWORD}

export TF_VAR_domain="gibbsgreatly.xyz"
export TF_VAR_ip_address="192.168.1.4"
export TF_VAR_hostname="management-stack"

# Harbor placeholders (for future phases)
export HARBOR_ADMIN_PASSWORD=${SERVICE_PASSWORD}
export HARBOR_DB_PASSWORD="harbor_db_${SERVICE_PASSWORD}"

# NPM placeholders (for future phases)  
export NPM_DB_PASSWORD="npm_db_${SERVICE_PASSWORD}"

export PORTAINER_ADMIN_PASSWORD=${SERVICE_PASSWORD}
