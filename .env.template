# Non-secret environment configuration — copy this to .env and adjust for your environment.
# Secrets (passwords, tokens, API keys) are stored in terraform/secrets.enc.yaml (SOPS-encrypted).
# They are injected automatically when you run: ./with-secrets <command>
#
# This file contains only deployment configuration that is safe to share and commit as a template.
# Your .env (actual values) is gitignored and should never be committed.

# ----------------------------------------------------------------
# Proxmox Host
# ----------------------------------------------------------------
export PROXMOX_HOST='pve.gibbsgreatly.xyz'       # FQDN or IP of your Proxmox node
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'

# ----------------------------------------------------------------
# Terraform Variables
# ----------------------------------------------------------------
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_node=pve                   # Proxmox node name
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_WORKSPACE=default                       # pve-test for the test environment
export TF_VAR_domain='gibbsgreatly.xyz'
export TF_VAR_ip_address='192.168.1.4'           # management stack IP
export TF_VAR_hostname='management-stack'

# pve-test environment overrides (uncomment and set when targeting pve-test):
# export TF_VAR_proxmox_node=pve-test
# export TF_VAR_proxmox_host=pve-test.gibbsgreatly.xyz
# export TF_WORKSPACE=pve-test
# export TF_VAR_portainer_server_ip=10.57.1.20
# export TF_VAR_registry_host=10.57.3.10
# export TF_VAR_apt_cacher_host=10.57.3.11

# ----------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------
export ANSIBLE_PRIVATE_KEY_FILE='~/.ssh/id_ed25519'
export ANSIBLE_HOST_KEY_CHECKING=False

# ----------------------------------------------------------------
# Service Endpoints
# ----------------------------------------------------------------
export HARBOR_HOSTNAME='harbor.gibbsgreatly.xyz'
export MIKROTIK_HOST='192.168.1.1'
export MIKROTIK_PORT=443
export MIKROTIK_USER='api-user'

# ----------------------------------------------------------------
# Tooling
# ----------------------------------------------------------------
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
