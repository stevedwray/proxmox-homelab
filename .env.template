# Non-secret environment configuration — copy this to .env and adjust for your environment.
# Secrets (passwords, tokens, API keys) are stored in terraform/secrets.enc.yaml (SOPS-encrypted).
# They are injected automatically when you run: ./with-secrets <command>
#
# This file contains only deployment configuration that is safe to share and commit as a template.
# Your .env (actual values) is gitignored and should never be committed.

# ----------------------------------------------------------------
# Proxmox Host
# ----------------------------------------------------------------
export PROXMOX_HOST='pve.gibbsgreatly.xyz'       # FQDN or IP of your Proxmox node
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'

# ----------------------------------------------------------------
# Terraform Variables
# ----------------------------------------------------------------
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_node=pve                   # Proxmox node name
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_WORKSPACE=default                       # pve-test for the test environment
export TF_VAR_domain='gibbsgreatly.xyz'
export TF_VAR_ip_address='192.168.1.4'           # management stack IP
export TF_VAR_hostname='management-stack'

# pve-test environment overrides (uncomment and set when targeting pve-test):
# export TF_VAR_proxmox_node=pve-test
# export TF_VAR_proxmox_host=pve-test.gibbsgreatly.xyz
# export TF_WORKSPACE=pve-test
# export TF_VAR_portainer_server_ip=10.57.1.20
# export TF_VAR_registry_host=10.57.3.10
# export TF_VAR_apt_cacher_host=10.57.3.11

# ----------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------
export ANSIBLE_PRIVATE_KEY_FILE='~/.ssh/id_ed25519'
export ANSIBLE_HOST_KEY_CHECKING=False

# ----------------------------------------------------------------
# Service Endpoints
# ----------------------------------------------------------------
export HARBOR_HOSTNAME='harbor.gibbsgreatly.xyz'
export HARBOR_OIDC_ENABLED=true
export HARBOR_OIDC_PROVIDER_NAME='authentik'
export HARBOR_OIDC_ENDPOINT='https://authentik.lab.gibbsgreatly.xyz/application/o/edge-harbor-stack-harbor/.well-known/openid-configuration'
export HARBOR_OIDC_CLIENT_ID='harbor'
export HARBOR_OIDC_GROUPS_CLAIM='groups'
export HARBOR_OIDC_ADMIN_GROUP='harbor-admins'
export HARBOR_OIDC_GROUP_FILTER='^harbor-.*'
export HARBOR_OIDC_SCOPE='openid,profile,email,offline_access'
export HARBOR_OIDC_USER_CLAIM='preferred_username'
export HARBOR_OIDC_VERIFY_CERT=true
export HARBOR_OIDC_AUTO_ONBOARD=true
export HARBOR_OIDC_LOGOUT=true
export HARBOR_OIDC_PRIMARY_AUTH_MODE=true
export MIKROTIK_HOST='192.168.1.251'       # Active pve-test MikroTik management IP
export MIKROTIK_PORT=443
export MIKROTIK_USER='api-user'
export MIKROTIK_ADMIN='dns-user'                             # Preferred automation user with write access
export MIKROTIK_ADMIN_PASSWORD=__FROM_BITWARDEN__  # MikroTik admin password (write access); api-user is read-only

# ----------------------------------------------------------------
# Phase 04 Secrets (Core Shared Services)
# ----------------------------------------------------------------
# Store real values in terraform/secrets.enc.yaml (SOPS-encrypted)
# Inject via: ./with-secrets <command>

# Authentik identity provider
export AUTHENTIK_SECRET_KEY='__FROM_BITWARDEN__'                # 50+ char random string for Authentik Django session key
export AUTHENTIK_POSTGRES_PASSWORD='__FROM_BITWARDEN__'         # PostgreSQL password for Authentik DB
export AUTHENTIK_SUPERUSER_PASSWORD='__FROM_BITWARDEN__'        # Initial Authentik admin password (set once, then use API)
export AUTHENTIK_SUPERUSER_API_TOKEN='__FROM_BITWARDEN__'       # Authentik admin API token (created after first boot)
export HARBOR_OIDC_CLIENT_SECRET='__FROM_BITWARDEN__'           # Authentik OIDC client secret for Harbor SSO

# Traefik reverse proxy
export CF_DNS_API_TOKEN='__FROM_BITWARDEN__'                    # Cloudflare API token with Zone:DNS:Edit scope for gibbsgreatly.xyz

# step-ca internal certificate authority
export STEP_CA_PASSWORD='__FROM_BITWARDEN__'                    # Passphrase protecting the step-ca CA private key
export STEP_CA_PROVISIONER_PASSWORD='__FROM_BITWARDEN__'        # Passphrase for the ACME provisioner in step-ca

# Grafana monitoring dashboard
export GRAFANA_ADMIN_PASSWORD='__FROM_BITWARDEN__'              # Initial Grafana admin password
export GRAFANA_OAUTH_CLIENT_SECRET='__FROM_BITWARDEN__'         # Authentik OIDC client secret for Grafana SSO

# ----------------------------------------------------------------
# Tooling
# ----------------------------------------------------------------
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
