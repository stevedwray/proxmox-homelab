/*
 * Generated by the icinga_observer role. Direct Discord/Telegram
 * notifications only -- never through Grafana, Graylog or
 * VictoriaMetrics (runbook Stage 3). Every critical service gets a
 * recovery notification and a 60s minimum notification interval.
 */

object NotificationCommand "discord-notification" {
  command = [ NotificationScriptsDir + "/notification-discord.sh" ]
  env.ICINGA_NOTIFICATION_TYPE = "$notification.type$"
  env.ICINGA_HOST_NAME = "$host.name$"
  env.ICINGA_SERVICE_NAME = "$service.name$"
  env.ICINGA_SERVICE_STATE = "$service.state$"
  env.ICINGA_SERVICE_OUTPUT = "$service.output$"
  timeout = 10s
}

object NotificationCommand "telegram-notification" {
  command = [ NotificationScriptsDir + "/notification-telegram.sh" ]
  env.ICINGA_NOTIFICATION_TYPE = "$notification.type$"
  env.ICINGA_HOST_NAME = "$host.name$"
  env.ICINGA_SERVICE_NAME = "$service.name$"
  env.ICINGA_SERVICE_STATE = "$service.state$"
  env.ICINGA_SERVICE_OUTPUT = "$service.output$"
  timeout = 10s
}

object User "operator" {
  email = "" // never used: Discord/Telegram only, no mail transport configured
}

object UserGroup "operators" {
  display_name = "Icinga observer operators"
  assign where true
}

object TimePeriod "24x7" {
  import "always-on"
  display_name = "Always"
}

template Notification "DefaultNotification" {
  period = "24x7"
}

apply Notification "discord" to Service {
  import DefaultNotification
  command = "discord-notification"
  users = [ "operator" ]
  interval = 60s
  states = [ Warning, Critical, Unknown ]
  types = [ Problem, Recovery, Acknowledgement ]
  assign where true
}

apply Notification "telegram" to Service {
  import DefaultNotification
  command = "telegram-notification"
  users = [ "operator" ]
  interval = 60s
  states = [ Critical, Unknown ]
  types = [ Problem, Recovery ]
  assign where true
}
