/*
 * Generated by the icinga_observer role.
 */

include "constants.conf"
include "zones.conf"

include <itl>
include <plugins>
include <plugins-contrib>
include <manubulon>
include <windows-plugins>
include <nscp>

{% if icinga_observer_is_master %}
include_recursive "zones.d"
{% endif %}

/*
 * No conf.d include: this role defines its own Host/Service/Notification
 * templates (zones.d/master/*.conf) instead of the package's demo config,
 * so no example "localhost" host or demo checks are ever active.
 */

object ApiListener "api" {
  accept_config = true
  accept_commands = true
  bind_host = "{{ icinga_observer_self_address }}"
  bind_port = {{ icinga_observer_api_port }}
}

object CheckerComponent "checker" { }
object NotificationComponent "notification" { }
object FileLogger "main-log" {
  path = "/var/log/icinga2/icinga2.log"
  severity = "information"
}
