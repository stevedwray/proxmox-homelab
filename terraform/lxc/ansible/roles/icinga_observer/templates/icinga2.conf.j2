/*
 * Generated by the icinga_observer role. Same layout as the package's own
 * icinga2.conf (so `icinga2 feature enable/disable` keeps working) minus
 * the conf.d demo config.
 */

include "constants.conf"
include "zones.conf"

include <itl>
include <plugins>

include "features-enabled/*.conf"

/*
 * Not included on purpose:
 *  - conf.d: this role defines its own Host/Service/Notification objects
 *    under zones.d/master, so the package's demo "localhost" host and mail
 *    notifications are never active.
 *  - zones.d: Icinga loads it automatically once the ApiListener and zone
 *    objects exist; including it by name too produced an exact duplicate
 *    object error (2026-10-25).
 *  - plugins-contrib/manubulon/windows-plugins/nscp: nothing here uses them
 *    and they need constants we do not define.
 */
