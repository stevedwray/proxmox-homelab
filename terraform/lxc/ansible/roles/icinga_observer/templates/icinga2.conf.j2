/*
 * Generated by the icinga_observer role.
 */

include "constants.conf"
include "zones.conf"

include <itl>
include <plugins>

/*
 * No manual `include_recursive "zones.d"` here: once the ApiListener and
 * zone objects exist (zones.conf, below), Icinga2 loads zones.d
 * automatically as part of its own cluster config-sync machinery.
 * Including it again by name produced an exact duplicate-object error
 * ("generic-host re-defined ... previous definition: the same file, the
 * same line") on 2026-10-25 -- confirmed not caused by the separate
 * /var/lib/icinga2/api/packages/_api staging area, which was empty.
 *
 * No conf.d include either: this role defines its own Host/Service/
 * Notification templates (zones.d/master/*.conf) instead of the
 * package's demo config, so no example "localhost" host or demo checks
 * are ever active.
 */

object ApiListener "api" {
  accept_config = true
  accept_commands = true
  bind_host = "{{ icinga_observer_self_address }}"
  bind_port = {{ icinga_observer_api_port }}
  cert_path = "/etc/icinga2/pki/" + NodeName + ".crt"
  key_path = "/etc/icinga2/pki/" + NodeName + ".key"
  ca_path = "/etc/icinga2/pki/ca.crt"
}

object CheckerComponent "checker" { }
object NotificationComponent "notification" { }
object FileLogger "main-log" {
  path = "/var/log/icinga2/icinga2.log"
  # "notice" (not "information"): cluster connect/reconnect/TLS handshake
  # events log at notice level, below "information" in Icinga2's severity
  # order -- an "information" FileLogger silently hid all cluster
  # connection activity during the Stage 1 drill on 2026-10-25.
  severity = "notice"
}
