#!/usr/bin/env bash
# Query an A record over TCP and require a successful DNS answer. dig exits 0
# for NXDOMAIN, so its process status alone cannot be used as a health check.
set -euo pipefail

if [[ $# -ne 4 || $1 != --server || $3 != --lookup ]]; then
  echo 'DNS TCP UNKNOWN - expected --server IPv4 --lookup NAME'
  exit 3
fi

server=$2
lookup=$4
if [[ ! $server =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ! $lookup =~ ^[A-Za-z0-9.-]+$ ]]; then
  echo 'DNS TCP UNKNOWN - invalid server or lookup name'
  exit 3
fi

if ! response=$(timeout 8 dig +tcp +time=3 +tries=1 +noall +comments +answer "@${server}" "${lookup}" A 2>&1); then
  printf 'DNS TCP CRITICAL - query failed for %s via %s\n' "$lookup" "$server"
  exit 2
fi

if ! grep -q 'status: NOERROR' <<< "$response"; then
  printf 'DNS TCP CRITICAL - no successful response for %s via %s\n' "$lookup" "$server"
  exit 2
fi

answers=$(awk '$4 == "A" && $5 ~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/ { print $5 }' <<< "$response" | paste -sd, -)
if [[ -z $answers ]]; then
  printf 'DNS TCP CRITICAL - no A answer for %s via %s\n' "$lookup" "$server"
  exit 2
fi

printf 'DNS TCP OK - %s via %s returned %s\n' "$lookup" "$server" "$answers"
