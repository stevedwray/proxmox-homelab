/*
 * Generated by the icinga_observer role. Authoritative on argon-01 only.
 *
 * Normal services use max_check_attempts = 2 with a 60s minimum
 * notification interval and a recovery notification; the Icinga-peer
 * checks use a separately, deliberately shorter rule (runbook Stage 1.3).
 * Local resource checks on each Pi (disk, clock) run with
 * command_endpoint = that Pi's own name, since those plugins only read
 * local state and cannot be executed remotely.
 */

template Service "generic-service" {
  max_check_attempts = 2
  check_interval = 2m
  retry_interval = 30s
  enable_notifications = true
  notes = "icinga_observer role -- docs/icinga-pi-observability/"
}

/* --- Icinga peer / self: short-rule detection ------------------------------ */

apply Service "cluster-zone-health" to Host {
  import "generic-service"
  check_command = "cluster-zone"
  max_check_attempts = 3
  check_interval = 20s
  retry_interval = 10s
  vars.cluster_zone = "master"
  command_endpoint = host.name
  assign where host.name in [ "argon-01", "argon-02" ]
}

apply Service "disk-root" to Host {
  import "generic-service"
  check_command = "disk"
  vars.disk_partitions = "/"
  vars.disk_wfree = 15
  vars.disk_cfree = 5
  command_endpoint = host.name
  assign where host.name in [ "argon-01", "argon-02" ]
}

/* Public NTP server: 1.1.1.1 (used previously) does not serve NTP. */
apply Service "clock" to Host {
  import "generic-service"
  check_command = "ntp_time"
  vars.ntp_address = "{{ icinga_observer_ntp_server }}"
  command_endpoint = host.name
  assign where host.name in [ "argon-01", "argon-02" ]
}

/*
 * Real TLS handshake on the cluster port plus certificate expiry, run from
 * the peer (see checked_by in hosts.conf).
 */
apply Service "api-tls-cert" to Host {
  import "generic-service"
  check_command = "ssl"
  max_check_attempts = 3
  retry_interval = 20s
  vars.ssl_address = host.address
  vars.ssl_port = {{ icinga_observer_api_port }}
  vars.ssl_cert_valid_days_warn = 30
  vars.ssl_cert_valid_days_critical = 7
  command_endpoint = host.vars.checked_by
  assign where host.name in [ "argon-01", "argon-02" ]
}

{% if icinga_observer_enable_web %}
/* The web stack is a non-critical consumer of the checker. Probe it from the
 * HA pair without making core checks depend on it. */
object CheckCommand "observer-ui-units" {
  command = [ "{{ icinga_observer_check_scripts_dir }}/check-observer-ui-units.sh" ]
}

apply Service "icinga-web-login" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_vhost = "{{ icinga_observer_web_fqdn }}"
  vars.http_ssl = true
  vars.http_sni = true
  vars.http_uri = "/icingaweb2/authentication/login"
  vars.http_expect = "302"
  assign where host.name == "argon-01"
}

apply Service "observer-ui-units" to Host {
  import "generic-service"
  check_command = "observer-ui-units"
  command_endpoint = host.name
  assign where host.name == "argon-01"
}
{% endif %}

{% if icinga_observer_enable_smokeping %}
/* The backend is firewall-limited to the Pi and Traefik, so run locally. */
apply Service "smokeping-cgi" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_vhost = "smokeping.{{ icinga_observer_lab_domain }}"
  vars.http_port = {{ icinga_observer_smokeping_web_port }}
  vars.http_uri = "/smokeping/smokeping.cgi"
  vars.http_expect = "200"
  command_endpoint = host.name
  assign where host.name == "argon-01"
}
{% endif %}

{% if 'router' in icinga_observer_core_check_groups %}
/* --- MikroTik: ICMP plus DNS recursion -------------------------------------- */

apply Service "icmp" to Host {
  import "generic-service"
  check_command = "ping4"
  assign where host.name == "mikrotik"
}

apply Service "dns-recursion" to Host {
  import "generic-service"
  check_command = "dns"
  vars.dns_lookup = "cloudflare.com"
  vars.dns_server = host.address
  assign where host.name == "mikrotik"
}
{% endif %}

{% if 'dns' in icinga_observer_core_check_groups %}
/* --- Technitium: UDP/TCP DNS for internal + public names ------------------- */

object CheckCommand "dns-tcp" {
  command = [ "{{ icinga_observer_check_scripts_dir }}/check-dns-tcp.sh" ]
  arguments = {
    "--server" = {
      value = "$dns_tcp_server$"
      required = true
      order = 1
    }
    "--lookup" = {
      value = "$dns_tcp_lookup$"
      required = true
      order = 2
    }
  }
}

apply Service "dns-internal" to Host {
  import "generic-service"
  check_command = "dig"
  vars.dig_lookup = "pve.gibbsgreatly.xyz"
  vars.dig_server = host.address
  vars.dig_record_type = "A"
  vars.dig_timeout = 8
  assign where host.name in [ "technitium-primary", "technitium-secondary" ]
}

apply Service "dns-recursive" to Host {
  import "generic-service"
  check_command = "dig"
  vars.dig_lookup = "cloudflare.com"
  vars.dig_server = host.address
  vars.dig_record_type = "A"
  vars.dig_timeout = 8
  assign where host.name in [ "technitium-primary", "technitium-secondary" ]
}

apply Service "dns-internal-tcp" to Host {
  import "generic-service"
  check_command = "dns-tcp"
  vars.dns_tcp_server = host.address
  vars.dns_tcp_lookup = "pve.gibbsgreatly.xyz"
  assign where host.name in [ "technitium-primary", "technitium-secondary" ]
}

apply Service "dns-recursive-tcp" to Host {
  import "generic-service"
  check_command = "dns-tcp"
  vars.dns_tcp_server = host.address
  vars.dns_tcp_lookup = "cloudflare.com"
  assign where host.name in [ "technitium-primary", "technitium-secondary" ]
}
{% endif %}

{% if 'pve' in icinga_observer_core_check_groups %}
/* --- pve: ICMP, TCP 8006, API health --------------------------------------- */

apply Service "icmp" to Host {
  import "generic-service"
  check_command = "ping4"
  assign where host.name == "pve"
}

apply Service "api-8006" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_vhost = "{{ icinga_observer_pve_host }}"
  vars.http_port = 8006
  vars.http_ssl = true
  vars.http_uri = "/api2/json/version"
  /* pve's API returns 401 No ticket without credentials; that still proves
     TLS and the API daemon are both healthy. */
  vars.http_expect = "401"
  assign where host.name == "pve"
}
{% endif %}

{% if 'metrics' in icinga_observer_core_check_groups %}
/* --- VictoriaMetrics /health, Grafana /api/health --------------------------- */

apply Service "health" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_port = 8428
  vars.http_uri = "/health"
  vars.http_string = "OK"
  assign where host.name == "victoriametrics"
}

apply Service "api-health" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_port = 3000
  vars.http_uri = "/api/health"
  vars.http_expect_body_regex = "\"database\"[[:space:]]*:[[:space:]]*\"ok\""
  assign where host.name == "grafana"
}

/* --- Graylog TCP 514 plus lbstatus ------------------------------------------ */

apply Service "syslog-input" to Host {
  import "generic-service"
  check_command = "tcp"
  vars.tcp_port = 514
  assign where host.name == "graylog"
}

apply Service "lbstatus" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_port = 9000
  vars.http_uri = "/api/system/lbstatus"
  vars.http_string = "ALIVE"
  assign where host.name == "graylog"
}
{% endif %}

{% if 'internal_services' in icinga_observer_core_check_groups %}
/* --- OpenBao sys/health (unsealed), step-ca ACME, Traefik, Portainer -------- */

/* Debian's Icinga 2.14 ITL lacks a curl CheckCommand even though the
 * monitoring-plugins-basic package includes check_curl. Scope the command
 * name to this role so a later ITL update cannot collide with it. */
object CheckCommand "observer-curl" {
  command = [ "/usr/lib/nagios/plugins/check_curl" ]
  arguments = {
    "-I" = "$address$"
    "-p" = "$curl_port$"
    "-S" = { set_if = "$curl_tls$" }
    "--ca-cert" = "$curl_ca_cert_file$"
    "-D" = { set_if = "$curl_verify_peer_cert$" }
    "-u" = "$curl_url$"
    "-s" = "$curl_expect_content_string$"
    "-r" = "$curl_ereg$"
    "-t" = "$curl_timeout$"
  }
}

apply Service "sys-health" to Host {
  import "generic-service"
  check_command = "observer-curl"
  vars.curl_port = 8200
  vars.curl_tls = true
  vars.curl_url = "/v1/sys/health"
  vars.curl_ca_cert_file = "{{ icinga_observer_ca_bundle }}"
  vars.curl_verify_peer_cert = true
  vars.curl_ereg = "\"sealed\"[[:space:]]*:[[:space:]]*false"
  vars.curl_timeout = 8
  assign where host.name == "openbao"
}

apply Service "acme-directory" to Host {
  import "generic-service"
  check_command = "observer-curl"
  vars.curl_tls = true
  vars.curl_url = "/acme/acme/directory"
  vars.curl_ca_cert_file = "{{ icinga_observer_ca_bundle }}"
  vars.curl_verify_peer_cert = true
  vars.curl_expect_content_string = "newAccount"
  vars.curl_timeout = 8
  assign where host.name == "step-ca"
}

/*
 * Traefik has no unauthenticated health/ping endpoint today (api.insecure
 * is false, no ping entrypoint configured) -- confirmed read-only on
 * 2026-10-25. Phase 1 falls back to a bare TCP check; adding Traefik's
 * `ping` static-config entrypoint is an Authentik/Traefik-tier change,
 * out of scope here (runbook open item, see README "Core check scope").
 */
apply Service "https-port" to Host {
  import "generic-service"
  check_command = "tcp"
  vars.tcp_port = 443
  assign where host.name == "traefik"
}

apply Service "api-status" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_port = 9000
  vars.http_uri = "/api/system/status"
  vars.http_string = "\"Version\""
  assign where host.name == "portainer"
}
{% endif %}

{% if 'oci' in icinga_observer_core_check_groups %}
/* --- OCI/Pangolin: public HTTPS, certificate, public DNS; SSH separately gated -- */

apply Service "https" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_ssl = true
  vars.http_sni = true
  vars.http_vhost = "{{ icinga_observer_oci_fqdn }}"
  assign where host.name == "oci-pangolin"
}

apply Service "certificate-expiry" to Host {
  import "generic-service"
  check_command = "http"
  vars.http_ssl = true
  vars.http_sni = true
  vars.http_vhost = "{{ icinga_observer_oci_fqdn }}"
  vars.http_certificate = 30
  assign where host.name == "oci-pangolin"
}

apply Service "public-dns" to Host {
  import "generic-service"
  check_command = "dns"
  /* Any answer from a public resolver (Cloudflare proxies this name, so the
     addresses differ from the MikroTik's static pointer at the real OCI IP). */
  vars.dns_lookup = "{{ icinga_observer_oci_fqdn }}"
  vars.dns_server = "{{ icinga_observer_resolver_a }}"
  assign where host.name == "oci-pangolin"
}

/*
 * SSH to OCI reuses the existing home-source-restricted identity and
 * alias ("ssh oci"); no new OCI firewall rule. by_ssh runs a harmless
 * fixed, non-interactive probe (runbook Stage 2).
 */
{% if icinga_observer_enable_oci_ssh_probe %}
apply Service "ssh-probe" to Host {
  import "generic-service"
  check_command = "by_ssh"
  vars.by_ssh_port = 22
  vars.by_ssh_logname = "ubuntu"
  vars.by_ssh_command = "true"
  vars.by_ssh_options = "BatchMode=yes,ConnectTimeout=5"
  command_endpoint = "argon-01"
  assign where host.name == "oci-pangolin"
}
{% endif %}
{% endif %}
