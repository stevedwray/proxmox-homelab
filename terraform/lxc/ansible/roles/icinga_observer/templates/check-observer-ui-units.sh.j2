#!/bin/sh
# Generated by the icinga_observer role. Checks the optional UI/data path.
set -eu

failed=""
for unit in icingadb redis-server mariadb php{{ icinga_observer_php_version }}-fpm nginx{% if icinga_observer_enable_smokeping %} smokeping fcgiwrap{% endif %}; do
  if ! systemctl is-active --quiet "$unit"; then
    state=$(systemctl is-active "$unit" 2>/dev/null || true)
    failed="${failed}${failed:+, }${unit}=${state:-unknown}"
  fi
done

if [ -n "$failed" ]; then
  printf 'CRITICAL - observer UI units: %s\n' "$failed"
  exit 2
fi

echo 'OK - observer UI units active'
