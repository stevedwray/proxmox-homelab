/*
 * Generated by the icinga_observer role. One shared "master" zone with
 * both Argon Pis as peer endpoints (HA, not a parent/child satellite
 * split) -- see docs/icinga-pi-observability/runbook.md "Fixed decisions".
 * Only argon-01 owns authoritative zones.d/master/* content; argon-02
 * receives it via Icinga's own configuration sync.
 */

{% for name, address in icinga_observer_nodes.items() %}
object Endpoint "{{ name }}" {
  host = "{{ address }}"
  port = {{ icinga_observer_api_port }}
}
{% endfor %}

object Zone "master" {
  endpoints = [ {% for name in icinga_observer_nodes.keys() %}"{{ name }}"{{ ", " if not loop.last else "" }}{% endfor %} ]
}

object Zone "global-templates" {
  global = true
}
