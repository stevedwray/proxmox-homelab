#!/bin/bash
# Generated by the icinga_observer role. Idempotent: re-applies the
# per-port source restrictions on boot, since no iptables-persistent is
# installed on this host. Role-owned; touches only the ports listed below
# and never Docker's FORWARD/NAT chains or any other rule.
set -euo pipefail
{% for rule in icinga_observer_firewall_rules %}

# {{ rule.name }}: tcp/{{ rule.port }} <- {{ rule.allow | join(', ') }} only
{% for src in rule.allow %}
iptables -C INPUT -p tcp --dport {{ rule.port }} -s {{ src }} -j ACCEPT 2>/dev/null || \
  iptables -I INPUT 1 -p tcp --dport {{ rule.port }} -s {{ src }} -j ACCEPT
{% endfor %}
iptables -C INPUT -p tcp --dport {{ rule.port }} -j REJECT 2>/dev/null || \
  iptables -A INPUT -p tcp --dport {{ rule.port }} -j REJECT
{% endfor %}
