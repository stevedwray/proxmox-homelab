/*
 * Generated by the icinga_observer role (replaces the package's stock
 * features-available/api.conf, as `icinga2 node setup` would). The node
 * certificate, key and CA are read from /var/lib/icinga2/certs by default.
 * Bound to this Pi's LAN address only; the host firewall additionally
 * restricts the port to the peer Pi.
 */
object ApiListener "api" {
  accept_config = true
  accept_commands = true
  bind_host = "{{ icinga_observer_self_address }}"
  bind_port = {{ icinga_observer_api_port }}
}
