/* Generated by the icinga_observer role. Categories for Icinga DB Web. */

object HostGroup "observer" {
  display_name = "Observer health"
  assign where host.name in [ "argon-01", "argon-02" ]
}
object ServiceGroup "observer" {
  display_name = "Observer health"
  assign where host.name in [ "argon-01", "argon-02" ] && service.name in [ "cluster-zone-health", "disk-root", "clock", "api-tls-cert" ]
}

{% if icinga_observer_enable_web or icinga_observer_enable_smokeping %}
object ServiceGroup "observer-ui" {
  display_name = "Observer web and diagnostics"
  assign where host.name == "argon-01" && service.name in [ "icinga-web-login", "observer-ui-units", "smokeping-cgi" ]
}
{% endif %}

{% if 'router' in icinga_observer_core_check_groups or 'dns' in icinga_observer_core_check_groups %}
object HostGroup "network-dns" {
  display_name = "Network and DNS"
  assign where host.name in [ "mikrotik", "technitium-primary", "technitium-secondary" ]
}
object ServiceGroup "network-dns" {
  display_name = "Network and DNS"
  assign where host.name in [ "mikrotik", "technitium-primary", "technitium-secondary" ]
}
{% endif %}

{% if 'pve' in icinga_observer_core_check_groups %}
object HostGroup "compute" {
  display_name = "Compute"
  assign where host.name == "pve"
}
object ServiceGroup "compute" {
  display_name = "Compute"
  assign where host.name == "pve"
}
{% endif %}

{% if 'metrics' in icinga_observer_core_check_groups %}
object HostGroup "monitoring-logs" {
  display_name = "Monitoring and logs"
  assign where host.name in [ "victoriametrics", "grafana", "graylog" ]
}
object ServiceGroup "monitoring-logs" {
  display_name = "Monitoring and logs"
  assign where host.name in [ "victoriametrics", "grafana", "graylog" ]
}
{% endif %}

{% if 'internal_services' in icinga_observer_core_check_groups %}
object HostGroup "internal-platform" {
  display_name = "Internal platform"
  assign where host.name in [ "openbao", "step-ca", "traefik", "portainer" ]
}
object ServiceGroup "internal-platform" {
  display_name = "Internal platform"
  assign where host.name in [ "openbao", "step-ca", "traefik", "portainer" ]
}
{% endif %}

{% if 'oci' in icinga_observer_core_check_groups %}
object HostGroup "public-edge" {
  display_name = "Public edge"
  assign where host.name == "oci-pangolin"
}
object ServiceGroup "public-edge" {
  display_name = "Public edge"
  assign where host.name == "oci-pangolin"
}
{% endif %}
