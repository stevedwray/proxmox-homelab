# Generated by the icinga_observer role. Icinga Web 2 served directly by this
# Pi -- not through Traefik, no Authentik -- with its own Let's Encrypt
# certificate (certbot, Cloudflare DNS-01) and Icinga Web's native login.
server {
  listen {{ icinga_observer_self_address }}:80;
  server_name {{ icinga_observer_web_fqdn }};
  return 301 https://{{ icinga_observer_web_fqdn }}$request_uri;
}

server {
  listen {{ icinga_observer_self_address }}:443 ssl;
  http2 on;
  server_name {{ icinga_observer_web_fqdn }};

  ssl_certificate     /etc/letsencrypt/live/{{ icinga_observer_web_fqdn }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ icinga_observer_web_fqdn }}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location = / {
    return 302 /icingaweb2/;
  }

  location ~ ^/icingaweb2/index\.php(.*)$ {
    fastcgi_pass unix:/run/php/php{{ icinga_observer_php_version }}-fpm.sock;
    fastcgi_index index.php;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /usr/share/icingaweb2/public/index.php;
    fastcgi_param ICINGAWEB_CONFIGDIR /etc/icingaweb2;
    fastcgi_param REMOTE_USER $remote_user;
  }

  location ~ ^/icingaweb2(.+)? {
    alias /usr/share/icingaweb2/public;
    index index.php;
    try_files $1 $uri $uri/ /icingaweb2/index.php$is_args$args;
  }
}
