/*
 * Generated by the icinga_observer role. Authoritative on argon-01 only;
 * synced to argon-02 by Icinga's own configuration sync.
 *
 * Scope follows docs/icinga-pi-observability/README.md "Core check scope".
 * Harbor, Authentik, NetBox, Nextcloud and application stacks are
 * deliberately out of phase 1.
 */

template Host "generic-host" {
  max_check_attempts = 2
  check_interval = 1m
  retry_interval = 30s
  check_command = "hostalive"
}

/*
 * The two observers. checked_by is the *other* node: a node's own API port
 * is firewalled to its peer only, so it can only be probed from there, and
 * a check run on the node itself would be rejected by its own rule.
 */
object Host "argon-01" {
  import "generic-host"
  address = "{{ icinga_observer_nodes['argon-01'] }}"
  vars.fqdn = "{{ icinga_observer_node_fqdns['argon-01'] }}"
  vars.checked_by = "argon-02"
}

object Host "argon-02" {
  import "generic-host"
  address = "{{ icinga_observer_nodes['argon-02'] }}"
  vars.fqdn = "{{ icinga_observer_node_fqdns['argon-02'] }}"
  vars.checked_by = "argon-01"
}

{% if 'router' in icinga_observer_core_check_groups %}
object Host "mikrotik" {
  import "generic-host"
  address = "{{ icinga_observer_mikrotik_host }}"
}
{% endif %}

{% if 'dns' in icinga_observer_core_check_groups %}
object Host "technitium-primary" {
  import "generic-host"
  address = "{{ icinga_observer_technitium_primary }}"
  vars.parent = "mikrotik"
}

object Host "technitium-secondary" {
  import "generic-host"
  address = "{{ icinga_observer_technitium_secondary }}"
  vars.parent = "mikrotik"
}
{% endif %}

{% if 'pve' in icinga_observer_core_check_groups %}
object Host "pve" {
  import "generic-host"
  address = "{{ icinga_observer_pve_host }}"
  vars.parent = "mikrotik"
}
{% endif %}

{% if 'metrics' in icinga_observer_core_check_groups %}
object Host "victoriametrics" {
  import "generic-host"
  address = "{{ icinga_observer_victoriametrics_host }}"
  vars.parent = "mikrotik"
}

object Host "grafana" {
  import "generic-host"
  address = "{{ icinga_observer_grafana_host }}"
  vars.parent = "mikrotik"
}

object Host "graylog" {
  import "generic-host"
  address = "{{ icinga_observer_graylog_host }}"
  vars.parent = "mikrotik"
}
{% endif %}

{% if 'internal_services' in icinga_observer_core_check_groups %}
object Host "openbao" {
  import "generic-host"
  address = "{{ icinga_observer_openbao_host }}"
  vars.parent = "mikrotik"
}

object Host "step-ca" {
  import "generic-host"
  address = "{{ icinga_observer_stepca_host }}"
  vars.parent = "mikrotik"
}

object Host "traefik" {
  import "generic-host"
  address = "{{ icinga_observer_traefik_host }}"
  vars.parent = "mikrotik"
}

object Host "portainer" {
  import "generic-host"
  address = "{{ icinga_observer_portainer_host }}"
  vars.parent = "mikrotik"
}
{% endif %}

{% if 'oci' in icinga_observer_core_check_groups %}
/* OCI drops ICMP, so hostalive would mark it DOWN forever: probe TCP 443. The
   name resolves via the MikroTik's static record to the real OCI address. */
object Host "oci-pangolin" {
  import "generic-host"
  address = "{{ icinga_observer_oci_fqdn }}"
  check_command = "tcp"
  vars.tcp_port = 443
}
{% endif %}

{% if 'router' in icinga_observer_core_check_groups %}
/*
 * MikroTik is modelled as a parent dependency for every LAN/pve/service
 * target so a single router fault produces one root-cause notification,
 * not an alert storm (runbook Stage 2).
 */
apply Dependency "mikrotik-parent" to Host {
  parent_host_name = "mikrotik"
  disable_notifications = true
  states = [ Up ]
  assign where host.vars.parent == "mikrotik"
}
{% endif %}
