#!/bin/bash
# Generated by the icinga_observer role. Root-owned, 0700. Reads its
# webhook URL only from a root-owned 0600 EnvironmentFile; never takes a
# secret on the command line or logs the payload (runbook Stage 3).
set -euo pipefail

ENV_FILE="{{ icinga_observer_env_file }}"
AUDIT_LOG="/var/log/icinga2/notifications-audit.log"
# shellcheck disable=SC1090
source "${ENV_FILE}"

if [[ -z "${ICINGA_DISCORD_WEBHOOK_URL:-}" ]]; then
  echo "$(date -Is) discord ${ICINGA_HOST_NAME:-unknown} ${ICINGA_SERVICE_NAME:-unknown} ${ICINGA_SERVICE_STATE:-unknown} missing-webhook" >> "${AUDIT_LOG}"
  exit 1
fi

MESSAGE="[${ICINGA_NOTIFICATION_TYPE:-UNKNOWN}] ${ICINGA_HOST_NAME:-unknown}/${ICINGA_SERVICE_NAME:-unknown} is ${ICINGA_SERVICE_STATE:-UNKNOWN}: ${ICINGA_SERVICE_OUTPUT:-}"

HTTP_CODE="$(curl --silent --show-error --fail --max-time 10 \
  --connect-timeout 5 \
  -H "Content-Type: application/json" \
  -d "$(jq -n --arg content "${MESSAGE}" '{content: $content}')" \
  -o /dev/null -w "%{http_code}" \
  "${ICINGA_DISCORD_WEBHOOK_URL}" || echo "curl-failed")"

RESULT="ok"
if [[ "${HTTP_CODE}" != "204" && "${HTTP_CODE}" != "200" ]]; then
  RESULT="failed-${HTTP_CODE}"
fi

echo "$(date -Is) discord ${ICINGA_HOST_NAME:-unknown} ${ICINGA_SERVICE_NAME:-unknown} ${ICINGA_SERVICE_STATE:-unknown} ${RESULT}" >> "${AUDIT_LOG}"

[[ "${RESULT}" == "ok" ]]
