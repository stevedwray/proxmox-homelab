#!/bin/bash
# Generated by the icinga_observer role. Root-owned, 0700. Reads its bot
# token and chat id only from a root-owned 0600 EnvironmentFile; never
# takes a secret on the command line or logs the payload (runbook Stage 3).
set -euo pipefail

ENV_FILE="{{ icinga_observer_env_file }}"
AUDIT_LOG="/var/log/icinga2/notifications-audit.log"
# shellcheck disable=SC1090
source "${ENV_FILE}"

if [[ -z "${ICINGA_TELEGRAM_BOT_TOKEN:-}" || -z "${ICINGA_TELEGRAM_CHAT_ID:-}" ]]; then
  echo "$(date -Is) telegram ${ICINGA_HOST_NAME:-unknown} ${ICINGA_SERVICE_NAME:-unknown} ${ICINGA_SERVICE_STATE:-unknown} missing-credentials" >> "${AUDIT_LOG}"
  exit 1
fi

MESSAGE="[${ICINGA_NOTIFICATION_TYPE:-UNKNOWN}] ${ICINGA_HOST_NAME:-unknown}/${ICINGA_SERVICE_NAME:-unknown} is ${ICINGA_SERVICE_STATE:-UNKNOWN}: ${ICINGA_SERVICE_OUTPUT:-}"

HTTP_CODE="$(curl --silent --show-error --fail --max-time 10 \
  --connect-timeout 5 \
  --data-urlencode "chat_id=${ICINGA_TELEGRAM_CHAT_ID}" \
  --data-urlencode "text=${MESSAGE}" \
  -o /dev/null -w "%{http_code}" \
  "https://api.telegram.org/bot${ICINGA_TELEGRAM_BOT_TOKEN}/sendMessage" || echo "curl-failed")"

RESULT="ok"
if [[ "${HTTP_CODE}" != "200" ]]; then
  RESULT="failed-${HTTP_CODE}"
fi

echo "$(date -Is) telegram ${ICINGA_HOST_NAME:-unknown} ${ICINGA_SERVICE_NAME:-unknown} ${ICINGA_SERVICE_STATE:-unknown} ${RESULT}" >> "${AUDIT_LOG}"

[[ "${RESULT}" == "ok" ]]
