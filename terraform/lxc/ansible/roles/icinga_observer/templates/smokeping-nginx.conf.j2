# Generated by the icinga_observer role. Loopback-only; reach it with
# `ssh -L 8080:127.0.0.1:{{ icinga_observer_smokeping_web_port }} ansible@{{ icinga_observer_nodes['argon-01'] }}`
# then browse http://127.0.0.1:8080/smokeping/ (runbook Stage 4). Never
# published through Traefik, Pangolin, Portainer, or a router rule.

server {
  listen 127.0.0.1:{{ icinga_observer_smokeping_web_port }};
  server_name localhost;

  location /smokeping/ {
    include fastcgi_params;
    fastcgi_pass unix:/var/run/fcgiwrap.socket;
    fastcgi_param SCRIPT_FILENAME /usr/lib/cgi-bin/smokeping.cgi;
    fastcgi_param SCRIPT_NAME /smokeping/smokeping.cgi;
  }

  location /smokeping/cache/ {
    alias /var/cache/smokeping/images/;
  }
}
