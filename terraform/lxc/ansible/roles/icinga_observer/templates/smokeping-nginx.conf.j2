# Generated by the icinga_observer role. SmokePing's web backend, bound to
# argon-01's own LAN address like every other lab service.
{% if icinga_observer_smokeping_behind_traefik | bool %}
# Browsers reach it as https://smokeping.{{ icinga_observer_lab_domain }} through Traefik
# (Authentik forwardAuth, terraform/lxc/stacks/smokeping/edge.yaml); the host
# firewall lets only Traefik ({{ icinga_observer_traefik_host }}) reach this port.
{% else %}
# Interim: reachable directly at http://{{ icinga_observer_self_address }}/smokeping/ until the
# Traefik route exists (icinga_observer_smokeping_behind_traefik).
{% endif %}

server {
  listen {{ icinga_observer_self_address }}:{{ icinga_observer_smokeping_web_port }} default_server;
  server_name _;

  location = / {
    return 302 /smokeping/smokeping.cgi;
  }

  location /smokeping/ {
    include fastcgi_params;
    fastcgi_pass unix:/var/run/fcgiwrap.socket;
    fastcgi_param SCRIPT_FILENAME /usr/lib/cgi-bin/smokeping.cgi;
    fastcgi_param SCRIPT_NAME /smokeping/smokeping.cgi;
  }

  location /smokeping/cache/ {
    alias /var/cache/smokeping/images/;
  }
}
