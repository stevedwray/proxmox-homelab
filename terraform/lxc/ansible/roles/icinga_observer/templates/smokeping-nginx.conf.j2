# Generated by the icinga_observer role. Bound to argon-01's own LAN
# address, same as every other lab service -- reach it directly at
# http://{{ icinga_observer_nodes['argon-01'] }}/smokeping/ from any LAN
# host (runbook Stage 4). Never published through Traefik, Pangolin,
# Portainer, or a router rule -- it's LAN-internal, not Internet-facing.

server {
  listen {{ icinga_observer_nodes['argon-01'] }}:{{ icinga_observer_smokeping_web_port }};
  server_name {{ icinga_observer_nodes['argon-01'] }};

  location /smokeping/ {
    include fastcgi_params;
    fastcgi_pass unix:/var/run/fcgiwrap.socket;
    fastcgi_param SCRIPT_FILENAME /usr/lib/cgi-bin/smokeping.cgi;
    fastcgi_param SCRIPT_NAME /smokeping/smokeping.cgi;
  }

  location /smokeping/cache/ {
    alias /var/cache/smokeping/images/;
  }
}
