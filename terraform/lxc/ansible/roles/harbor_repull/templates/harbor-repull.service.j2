[Unit]
Description=Non-destructive scheduled re-pull of known Harbor-routed images
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=REGISTRY_HOST={{ harbor_repull_registry_host }}
Environment=HARBOR_REPULL_MANIFEST={{ harbor_repull_manifest_path }}
ExecStart=/usr/bin/python3 {{ harbor_repull_dir }}/harbor_repull.py
StandardOutput=append:{{ harbor_repull_log_path }}
StandardError=append:{{ harbor_repull_log_path }}

[Install]
WantedBy=multi-user.target
