{
  "registry-mirrors": ["http://{{ docker_registry_mirror }}:{{ docker_registry_mirror_port | default(5000) }}"],
  "insecure-registries": ["{{ docker_registry_mirror }}:{{ docker_registry_mirror_port | default(5000) }}"],
  "log-driver": "syslog",
  "log-opts": {
    "syslog-address": "tcp://127.0.0.1:10514",
    "syslog-format": "rfc5424",
    "tag": "{% raw %}docker/{{.Name}}{% endraw %}"
  },
  "storage-driver": "overlay2"
}
