# Harbor configuration — managed by Ansible (harbor_installer role).
# Regenerate docker-compose and component configs by re-running the role;
# do NOT edit this file manually on the server.

hostname: {{ harbor_hostname }}

http:
  port: {{ harbor_http_port }}

# HTTPS is terminated externally by Nginx Proxy Manager with a Let's Encrypt
# certificate. Harbor serves plain HTTP internally on port {{ harbor_http_port }}.
# Uncomment and configure the section below only if you switch to Harbor-native TLS.
# https:
#   port: 443
#   certificate: /opt/harbor/certs/harbor.crt
#   private_key: /opt/harbor/certs/harbor.key

harbor_admin_password: {{ harbor_admin_password }}

database:
  password: {{ harbor_db_password }}
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

data_volume: {{ harbor_data_volume }}

trivy:
  ignore_unfixed: false
  skip_update: false
  offline_scan: false
  security_check: vuln
  insecure: false
  timeout: 5m0s

jobservice:
  max_job_workers: {{ harbor_jobservice_workers }}
  job_logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: {{ harbor_log_level }}
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

_version: {{ harbor_version }}

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy
