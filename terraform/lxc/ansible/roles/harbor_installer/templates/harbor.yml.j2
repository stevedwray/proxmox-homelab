# Harbor configuration — managed by Ansible (harbor_installer role).
# Regenerate docker-compose and component configs by re-running the role;
# do NOT edit this file manually on the server.

hostname: {{ harbor_installer_hostname }}
external_url: {{ harbor_installer_external_url }}

http:
  port: {{ harbor_installer_http_port }}

# Harbor OIDC auth is configured post-install via the Harbor API because
# harbor.yml does not expose the provider settings directly.

# HTTPS is terminated externally by Nginx Proxy Manager with a Let's Encrypt
# certificate. Harbor serves plain HTTP internally on port {{ harbor_installer_http_port }}.
# Uncomment and configure the section below only if you switch to Harbor-native TLS.
# https:
#   port: 443
#   certificate: /opt/harbor/certs/harbor.crt
#   private_key: /opt/harbor/certs/harbor.key

harbor_admin_password: {{ harbor_installer_admin_password }}

database:
  password: {{ harbor_installer_db_password }}
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

data_volume: {{ harbor_installer_data_volume }}

trivy:
  ignore_unfixed: false
  skip_update: false
  skip_java_db_update: false
  db_repository: ghcr.io/aquasecurity/trivy-db
  java_db_repository: ghcr.io/aquasecurity/trivy-java-db
  offline_scan: false
  security_check: vuln
  insecure: false
  timeout: 5m0s

jobservice:
  max_job_workers: {{ harbor_installer_jobservice_workers }}
  max_job_duration_hours: 24
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: {{ harbor_installer_log_level }}
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

_version: {{ harbor_installer_version }}

metric:
  enabled: true
  port: 9090
  path: /metrics

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
