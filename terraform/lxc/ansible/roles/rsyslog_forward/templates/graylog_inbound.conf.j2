## Inbound syslog relay for Graylog. rsyslog receives on :514 (TCP + UDP)
## from external appliances (Proxmox host, MikroTik) and Docker daemon on
## :10514, then relays everything to Graylog's syslog TCP input on
## `{{ rsyslog_forward_target_host }}:{{ rsyslog_forward_target_port }}`.
##
## Port 514 is bound by rsyslog (systemd root process). Graylog's container
## listens only on localhost:5140 and never binds 514 directly.
##
## Graylog only ever sees this relay as the sender (gl2_remote_ip is the
## Docker bridge), so the relay stamps each message with the real sender
## address as an RFC 5424 structured-data element. Graylog's syslog input
## turns it into the `relay_src_ip` field, which pipeline rules route on
## (configure-graylog-pentest-seg.yml). Any structured data the sender
## supplied itself is kept after it.

template(name="GraylogRelay" type="string"
  string="<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %programname% %PROCID% - %$.relay_sd% %msg%\n")

ruleset(name="relay-out") {
    set $.relay_sd = "[relay@32473 relay_src_ip=\"" & $fromhost-ip & "\"]";
    if $structured-data != "-" then {
        set $.relay_sd = $.relay_sd & $structured-data;
    }
    *.* action(type="omfwd"
               target="{{ rsyslog_forward_target_host }}"
               port="{{ rsyslog_forward_target_port }}"
               protocol="tcp"
               Template="GraylogRelay"
               queue.type="LinkedList"
               queue.filename="graylog-ext-tcp"
               queue.maxDiskSpace="32m"
               queue.saveOnShutdown="on"
               action.resumeRetryCount="-1")
}

# UDP senders (MikroTik) send BSD syslog, so this ruleset keeps rsyslog's
# default parser chain rather than forcing RFC 5424.
ruleset(name="ext-udp") {
    call relay-out
}

ruleset(name="ext-tcp" parser="rsyslog.rfc5424") {
    call relay-out
}

module(load="imudp")
input(type="imudp" port="{{ rsyslog_inbound_udp_port }}" ruleset="ext-udp")

input(type="imtcp" port="{{ rsyslog_inbound_tcp_port }}" address="0.0.0.0" ruleset="ext-tcp")
