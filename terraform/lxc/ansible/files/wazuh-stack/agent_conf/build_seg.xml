<agent_config>

  <!-- Shared agent configuration here -->

</agent_config>

<!-- Phase 2a (docs/wazuh-tuning): the GitHub Actions runner writes diagnostic logs and, when it self-updates,
     unpacks thousands of files under _work/_update before swapping them in. The installed runner files
     themselves stay monitored. -->
<agent_config name="ci-runner-01">
  <syscheck>
    <ignore>/opt/actions-runner/_diag</ignore>
    <ignore>/opt/actions-runner/_work/_update</ignore>
  </syscheck>
</agent_config>
