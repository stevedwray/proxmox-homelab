    <srcip>192.168.70.11</srcip>
    <description>sshd: non-existent user probe from the Greenbone scanner 192.168.70.11 (lowered)</description>
  </rule>
  <rule id="100201" level="3">
    <if_sid>5712</if_sid>
    <srcip>192.168.70.11</srcip>
