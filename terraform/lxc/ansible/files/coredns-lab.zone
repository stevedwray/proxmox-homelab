$ORIGIN lab.gibbsgreatly.xyz.
$TTL 5m

@               IN  SOA ns1.lab.gibbsgreatly.xyz. admin.lab.gibbsgreatly.xyz. (
						2026053003 ; serial
					1h         ; refresh
					15m        ; retry
					30d        ; expire
					5m         ; minimum
)

@               IN  NS  ns1.lab.gibbsgreatly.xyz.
ns1             IN  A   ${LAB_IP_DNS}

; Phase 04 core services (mgmt_seg)
authentik       A   ${LAB_IP_PROXY}     ; identity provider (via Traefik)
step-ca         A   ${LAB_IP_STEP_CA}   ; internal CA
monitoring      A   ${LAB_IP_MONITORING}; observability stack
grafana         A   ${LAB_IP_PROXY}     ; Grafana (via Traefik)

; Phase 04 edge services (edge_seg)
traefik         A   ${LAB_IP_PROXY}     ; reverse proxy
harbor          A   ${LAB_IP_PROXY}     ; harbor registry (via Traefik)
portainer       A   ${LAB_IP_PROXY}     ; portainer (via Traefik)
netbox          A   ${LAB_IP_PROXY}     ; netbox (via Traefik)

; Breakglass direct-access records (bypass Traefik — point to service container IP)
authentik-int   IN  A   ${LAB_IP_AUTHENTIK} ; authentik internal machine endpoint
authentik-bg    IN  A   ${LAB_IP_AUTHENTIK} ; authentik direct (breakglass)
harbor-bg       IN  A   ${LAB_IP_HARBOR}    ; harbor direct (breakglass)
monitoring-bg   IN  A   ${LAB_IP_MONITORING}; grafana/monitoring direct (breakglass)
netbox-bg       IN  A   ${LAB_IP_NETBOX}    ; netbox direct (breakglass)
portainer-bg    IN  A   ${LAB_IP_PORTAINER} ; portainer direct (breakglass)
proxy-bg        IN  A   ${LAB_IP_PROXY}     ; traefik dashboard direct (breakglass)

; Phase 06 application services — populated during app migration
; pihole       A   10.60.0.10          (Pi-hole, migrated in Phase 06)
; arr          A   10.60.0.20          (arr stack, migrated in Phase 06)
; jellyfin     A   10.60.0.30          (Jellyfin, migrated in Phase 06)
