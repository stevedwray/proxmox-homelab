{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Full-stack log explorer, filterable by hostname, severity, and free-text search",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "{hostname=~\"$hostname\", severity=~\"$severity\"} _msg:~\"$search\" | stats by (hostname) count()",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Host",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{hostname=~\"$hostname\", severity=~\"$severity\"} _msg:~\"$search\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
  ],
  "refresh": "",
  "schemaVersion": 38,
  "tags": ["lab", "logs", "victorialogs"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
        "definition": "fieldValue - hostname",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "hostname",
        "options": [],
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "hostname",
          "query": "*",
          "limit": 1000
        },
        "refresh": 2,
        "regex": "^[a-zA-Z][a-zA-Z0-9._-]+$",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
        "definition": "fieldValue - severity",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "severity",
        "options": [],
        "query": {
          "refId": "VictoriaLogsVariableQueryEditor-VariableQuery",
          "type": "fieldValue",
          "field": "severity",
          "query": "*",
          "limit": 100
        },
        "refresh": 2,
        "regex": "^[0-7]$",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "name": "search",
        "options": [{ "selected": true, "text": ".*", "value": ".*" }],
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Lab Logs",
  "uid": "lab-logs",
  "version": 5
}
