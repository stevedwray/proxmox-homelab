  "description": "Full-stack log explorer, filterable by host, stack, and severity",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{stack=~\"$stack\",host=~\"$host\"} |= \"$search\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Log Volume",
      "type": "logs"
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "id": 2,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "{stack=~\"$stack\",host=~\"$host\"} |= \"$search\" | stats count() by (stack)",
          "legendFormat": "{{stack}}",
          "refId": "A"
        }
      ],
      "title": "Log Rate by Stack",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "VictoriaLogs" },
