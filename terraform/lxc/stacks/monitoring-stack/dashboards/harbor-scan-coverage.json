  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["harbor", "security", "trivy", "scan-coverage"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "definition": "label_values(harbor_findings_repositories_total{job=\"harbor-findings-exporter\"}, project)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(harbor_findings_repositories_total{job=\"harbor-findings-exporter\"}, project)",
