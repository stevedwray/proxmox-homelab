        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Containers restarted (1h)",
      "description": "Containers whose start time changed in the last hour. Expect ~31 for an hour after the daily 04:09 reboot, 0 otherwise.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(sum by (name)(changes(container_start_time_seconds{job=\"cadvisor\",stack=\"tpot-honeypot\",name!=\"\"}[1h])) > 0) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
