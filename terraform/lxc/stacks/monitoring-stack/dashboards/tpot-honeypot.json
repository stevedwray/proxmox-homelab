          "expr": "sum by (name)(rate(container_network_receive_bytes_total{job=\"cadvisor\",stack=\"tpot-honeypot\",name!~\"elasticsearch|kibana|logstash|map_.*|tpotinit|p0f|suricata|honeytrap|nginx|ewsposter|spiderfoot|cadvisor\",name=~\"$container\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
