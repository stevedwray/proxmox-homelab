    {
      "type": "timeseries",
      "title": "Host NIC throughput (eth0)",
      "description": "Traffic on the Pi's real NIC (includes the honeypots' inbound attack traffic, the sync job and monitoring)",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (direction)(label_replace(rate(container_network_receive_bytes_total{job=\"cadvisor\",stack=\"tpot-honeypot\",name=\"suricata\",interface=\"eth0\"}[5m]),\"direction\",\"in\",\"\",\"\")) or sum by (direction)(label_replace(rate(container_network_transmit_bytes_total{job=\"cadvisor\",stack=\"tpot-honeypot\",name=\"suricata\",interface=\"eth0\"}[5m]),\"direction\",\"out\",\"\",\"\"))",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Packets/s on eth0",
