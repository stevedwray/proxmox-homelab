          "expr": "gvm_task_running",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "task",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "severity 1": true,
              "severity 2": true,
              "__name__": true,
              "kind 2": true,
              "kind 3": true,
              "kind 4": true,
              "kind 5": true,
              "kind 6": true,
              "instance": true,
              "job": true,
              "stack": true
            },
            "renameByName": {
              "kind 1": "Kind",
              "Value #A": "Last scan age (days)",
              "Value #B": "Duration (min)",
              "Value #C": "High+",
              "Value #D": "Medium",
              "Value #E": "Scheduled",
              "Value #F": "Running",
              "task": "Task"
            }
          }
        }
      ],
      "title": "Tasks",
      "type": "table"
