          "expr": "sum by (kind) (gvm_task_running)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Running scans by kind",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Sum of result_count over each task's last report (hole = High/Critical).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
