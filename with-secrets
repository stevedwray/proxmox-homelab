#!/bin/bash
# with-secrets — run a command with non-secret config and secrets both injected.
#
# Load order:
#   1. .env (repo root, gitignored) — non-secret environment config
#   2. .env.<PVE_ENV> (repo root, gitignored) — environment-specific non-secret overrides
#   3. terraform/secrets.enc.yaml (SOPS-encrypted) — actual secrets
#
# Secrets take precedence if the same key appears in both files.
# Nothing is written to disk; secret values exist only in the subprocess env.
#
# Usage:
#   ./with-secrets tofu plan
#   ./with-secrets ansible-playbook -i ansible/inventory/dev.yml playbook.yml
#   ./with-secrets sonar-scanner
#   ./with-secrets snyk iac test terraform/
#
# The age private key is read from ~/.config/sops/age/keys.txt automatically.
# Ensure the key exists and is mode 0600 before running this script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
ENV_FILE="${SCRIPT_DIR}/.env"
HARBOR_STACK_FILE="${SCRIPT_DIR}/terraform/lxc/stacks/harbor-stack/stack.yaml"

if [[ ! -f "${AGE_KEY_FILE}" ]]; then
    echo "ERROR: age private key not found at ${AGE_KEY_FILE}" >&2
    echo "Retrieve from Bitwarden: 'proxmox-homelab age private key'" >&2
    echo "Then: mkdir -p ~/.config/sops/age && install -m 600 /dev/stdin ${AGE_KEY_FILE}" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: $(basename "${BASH_SOURCE[0]}") <command> [args...]" >&2
    exit 1
fi

# Preserve caller intent for PVE_ENV so inline overrides like
# `ALLOW_PVE=true PVE_ENV=pve ./with-secrets ...` are not reset by sourced .env.
REQUESTED_PVE_ENV_SET="${PVE_ENV+x}"
REQUESTED_PVE_ENV="${PVE_ENV-}"

# Load non-secret config from .env if present (secrets below take precedence)
if [[ -f "${ENV_FILE}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${ENV_FILE}"
    set +a
fi

# Load environment-specific overrides. Default to pve-test for development safety.
# These override .env values and are also overridden by SOPS secrets.
if [[ -n "${REQUESTED_PVE_ENV_SET}" ]]; then
    PVE_ENV="${REQUESTED_PVE_ENV}"
else
    PVE_ENV="${PVE_ENV:-pve-test}"
fi
export PVE_ENV

if [[ -n "${PVE_ENV}" ]]; then
    ENV_OVERRIDE_FILE="${SCRIPT_DIR}/.env.${PVE_ENV}"
    if [[ -f "${ENV_OVERRIDE_FILE}" ]]; then
        set -a
        # shellcheck source=/dev/null
        source "${ENV_OVERRIDE_FILE}"
        set +a
    else
        echo "ERROR: PVE_ENV=${PVE_ENV} selected but ${ENV_OVERRIDE_FILE} not found" >&2
        echo "Create the overlay file or choose a different PVE_ENV." >&2
        exit 1
    fi
fi

# Select secrets file: prefer an env-specific encrypted file if it exists,
# otherwise fall back to the default dev secrets file.
ENV_SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.${PVE_ENV}.enc.yaml"
if [[ -f "${ENV_SECRETS_FILE}" ]]; then
    SECRETS_FILE="${ENV_SECRETS_FILE}"
else
    SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.enc.yaml"
fi

if [[ ! -f "${SECRETS_FILE}" ]]; then
    echo "ERROR: secrets file not found at ${SECRETS_FILE}" >&2
    echo "Expected: terraform/secrets.${PVE_ENV}.enc.yaml or terraform/secrets.enc.yaml" >&2
    exit 1
fi

normalize_lab_tfvars() {
    local var_name value ref_name ref_value tf_var_name

    for var_name in $(compgen -A variable LAB_); do
        value="${!var_name}"
        [[ -n "${value}" ]] || continue
        tf_var_name="TF_VAR_${var_name,,}"
        if [[ -z "${!tf_var_name-}" ]]; then
            export "${tf_var_name}=${value}"
        fi
    done

    for var_name in $(compgen -A variable TF_VAR_lab_); do
        value="${!var_name}"
        if [[ "${value}" =~ ^\$\{([A-Z0-9_]+)\}$ ]]; then
            ref_name="${BASH_REMATCH[1]}"
            ref_value="${!ref_name-}"
            if [[ "${ref_name}" == LAB_* && -n "${ref_value}" ]]; then
                export "${var_name}=${ref_value}"
            fi
        fi
    done
}

normalize_lab_tfvars

if [[ -z "${LAB_IP_HARBOR:-}" && -n "${TF_VAR_registry_host:-}" ]]; then
    export LAB_IP_HARBOR="${TF_VAR_registry_host}"
fi

if [[ -z "${TF_VAR_registry_host:-}" && -n "${LAB_IP_HARBOR:-}" ]]; then
    export TF_VAR_registry_host="${LAB_IP_HARBOR}"
fi

if [[ -z "${LAB_IP_HARBOR:-}" && -f "${HARBOR_STACK_FILE}" ]]; then
    HARBOR_STACK_IP="$(awk -F '"' '/^ip_address:/ {print $2; exit}' "${HARBOR_STACK_FILE}" | cut -d/ -f1)"
    if [[ -n "${HARBOR_STACK_IP}" ]]; then
        export LAB_IP_HARBOR="${HARBOR_STACK_IP}"
    fi
fi

if [[ -z "${TF_VAR_registry_host:-}" && -n "${LAB_IP_HARBOR:-}" ]]; then
    export TF_VAR_registry_host="${LAB_IP_HARBOR}"
fi

# Safety rail: block production node access. Any non-production test node is allowed.
# Use ./with-secrets-prod for production (pve) access; set ALLOW_PVE=true only for
# explicit, intentional overrides (e.g. cross-checking prod vs test config).
if [[ "${ALLOW_PVE:-false}" != "true" ]]; then
    if [[ "${PVE_ENV}" == "pve" ]]; then
        echo "ERROR: Refusing to run with PVE_ENV=pve (production node)" >&2
        echo "Use ./with-secrets-prod for production access." >&2
        echo "To override intentionally, set ALLOW_PVE=true for that command." >&2
        exit 1
    fi

    if [[ "${TF_VAR_proxmox_node:-}" == "pve" ]]; then
        echo "ERROR: Refusing to run with TF_VAR_proxmox_node=pve (production node)" >&2
        echo "Check .env/.env.${PVE_ENV} and with-secrets load order." >&2
        echo "To override intentionally, set ALLOW_PVE=true for that command." >&2
        exit 1
    fi
fi

# When an env-specific secrets file is selected, merge it on top of the shared
# base secrets so stacks can access shared secrets (node_exporter, CF_DNS_API_TOKEN,
# etc.) that aren't duplicated in the env-specific file.
BASE_SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.enc.yaml"
if [[ "${SECRETS_FILE}" != "${BASE_SECRETS_FILE}" && -f "${BASE_SECRETS_FILE}" ]]; then
    exec env SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" \
        "${SCRIPT_DIR}/scripts/merge-sops-env.sh" \
            "${BASE_SECRETS_FILE}" "${SECRETS_FILE}" \
            -- "$@"
else
    exec env SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" \
        sops exec-env "${SECRETS_FILE}" "$(printf '%q ' "$@")"
fi
