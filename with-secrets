#!/bin/bash
# with-secrets — run a command with non-secret config and secrets both injected.
#
# Load order:
#   1. .env (repo root, gitignored) — non-secret environment config
#   2. terraform/secrets.enc.yaml (SOPS-encrypted) — actual secrets
#
# Secrets take precedence if the same key appears in both files.
# Nothing is written to disk; secret values exist only in the subprocess env.
#
# Usage:
#   ./with-secrets tofu plan
#   ./with-secrets ansible-playbook -i ansible/inventory/dev.yml playbook.yml
#   ./with-secrets sonar-scanner
#   ./with-secrets snyk iac test terraform/
#
# The age private key is read from ~/.config/sops/age/keys.txt automatically.
# Ensure the key exists and is mode 0600 before running this script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.enc.yaml"
AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
ENV_FILE="${SCRIPT_DIR}/.env"

if [[ ! -f "${AGE_KEY_FILE}" ]]; then
    echo "ERROR: age private key not found at ${AGE_KEY_FILE}" >&2
    echo "Retrieve from Bitwarden: 'proxmox-homelab age private key'" >&2
    echo "Then: mkdir -p ~/.config/sops/age && install -m 600 /dev/stdin ${AGE_KEY_FILE}" >&2
    exit 1
fi

if [[ ! -f "${SECRETS_FILE}" ]]; then
    echo "ERROR: secrets file not found at ${SECRETS_FILE}" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: $(basename "${BASH_SOURCE[0]}") <command> [args...]" >&2
    exit 1
fi

# Load non-secret config from .env if present (secrets below take precedence)
if [[ -f "${ENV_FILE}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${ENV_FILE}"
    set +a
fi

# Load environment-specific overrides when PVE_ENV is set (e.g. PVE_ENV=pve-test)
# These override .env values and are also overridden by SOPS secrets.
PVE_ENV="${PVE_ENV:-}"
if [[ -n "${PVE_ENV}" ]]; then
    ENV_OVERRIDE_FILE="${SCRIPT_DIR}/.env.${PVE_ENV}"
    if [[ -f "${ENV_OVERRIDE_FILE}" ]]; then
        set -a
        # shellcheck source=/dev/null
        source "${ENV_OVERRIDE_FILE}"
        set +a
    else
        echo "WARNING: PVE_ENV=${PVE_ENV} set but ${ENV_OVERRIDE_FILE} not found" >&2
    fi
fi

exec env SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" \
    sops exec-env "${SECRETS_FILE}" "$(printf '%q ' "$@")"
