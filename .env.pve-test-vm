# .env.pve-test-vm — non-secret environment config for pve-test-vm
#
# Copy to .env.pve-test-vm and fill in values.
# To use: PVE_ENV=pve-test-vm ./with-secrets <command>
#
# Secrets (TF_VAR_pm_api_token_secret, TF_VAR_lxc_password, etc.) are in
# terraform/secrets.pve-test-vm.enc.yaml — do NOT put them here.

# Proxmox target node and connection
TF_VAR_proxmox_node=pve-test-vm
TF_VAR_proxmox_api_url=https://pve-test-vm.gibbsgreatly.xyz:8006/api2/json
TF_VAR_pm_api_token_id=automation@pve!terraform
TF_VAR_pm_tls_insecure=true

# Proxmox host (used by Ansible delegate_to for root@pam operations)
TF_VAR_proxmox_host=pve-test-vm.gibbsgreatly.xyz
PROXMOX_HOST=pve-test-vm.gibbsgreatly.xyz

# Ansible inventory lookup
PROXMOX_TESTBED_HOST_IP=192.168.1.41
PVE_TEST_FQDN=pve-test-vm.gibbsgreatly.xyz

# Default gateway for LXC containers (set to your lab router/MikroTik LAN IP)
TF_VAR_default_gateway=192.168.1.1

# Lab network segment IPs — set these to match stack.yaml ip_address values
LAB_IP_PORTAINER=192.168.20.20
LAB_IP_AUTHENTIK=192.168.20.10
LAB_IP_STEP_CA=192.168.20.11
LAB_IP_MONITORING=192.168.20.12
LAB_IP_DNS=192.168.20.13
LAB_IP_PROXY=192.168.30.10
LAB_IP_HARBOR=192.168.40.10
LAB_IP_NETBOX=192.168.40.12
LAB_IP_APT_CACHER=192.168.40.11
LAB_IP_CI_RUNNER=192.168.10.63

# Lab network gateways (MikroTik VLAN interfaces)
LAB_GW_MGMT=192.168.20.1
LAB_GW_EDGE=192.168.30.1
LAB_GW_INFRA=192.168.40.1
LAB_GW_BUILD=192.168.10.1

# Lab subnet CIDRs (used by network intent rendering)
LAB_SUBNET_MGMT_CIDR=192.168.20.0/24
LAB_SUBNET_EDGE_CIDR=192.168.30.0/24
LAB_SUBNET_INFRA_CIDR=192.168.40.0/24
LAB_SUBNET_BUILD_CIDR=192.168.10.0/24

# Lab domain
LAB_DOMAIN=lab.gibbsgreatly.xyz

# Registry and apt-cacher (set after Harbor is deployed)
TF_VAR_registry_host=192.168.40.10
TF_VAR_apt_cacher_host=192.168.40.11
