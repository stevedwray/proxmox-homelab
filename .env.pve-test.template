# pve-test non-secret overlay template
# Copy to .env.pve-test (gitignored) and adjust for your environment.
# This file owns pve-test target selection and related non-secret overrides.
# This file must contain non-secret values only.

export PVE_ENV='pve-test'

# Proxmox endpoint selection (test)
export PROXMOX_HOST='pve-test.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
## Preferred read-only discovery token ID (non-secret).
# This value is the non-secret token identifier created on the Proxmox host
# (format: `user@realm!tokenid`). Keep the secret value
# `PROXMOX_READONLY_TOKEN_SECRET` encrypted in this node's own
# `terraform/secrets.<node>.enc.yaml` (SOPS) — per-node, not
# `secrets.common.enc.yaml`, since this token is meaningless against any
# other node's API. Copy this template to `.env.pve-test` and set
# `PROXMOX_READONLY_TOKEN_ID` there so `./with-secrets` exposes the
# identifier to runtime commands. Do NOT store the token secret in
# `.env.pve-test`.
export PROXMOX_READONLY_TOKEN_ID='automation@pve!terraform-readonly'

## Legacy full-scope token ID (fallback only).
## Operators should prefer the read-only token name above; keep this as an
## explicit compatibility fallback only.
export PROXMOX_TOKEN_ID='automation@pve!terraform'

# External NetBox populate runner configuration
# `NETBOX_GUEST_SSH_USER` is supported as an interim/fallback mechanism for guest inspection; prefer proxy-based Docker API discovery (docker-socket-proxy) when available
# When a per-guest `DOCKER_SOCKET_PROXY_URL_TEMPLATE` (or legacy
# `DOCKER_SOCKET_PROXY_URL`) is configured, the runner prefers the proxy path
# and does not require a mounted `NETBOX_GUEST_SSH_IDENTITY_FILE`.
export NETBOX_GUEST_SSH_USER='automation'
# Preferred MikroTik discovery credentials (primary path)
# - MIKROTIK_READONLY_USER (non-secret identifier; set here)
# - MIKROTIK_READONLY_PASSWORD (secret; store in terraform/secrets.common.enc.yaml via SOPS)
# Do NOT place passwords into `.env.pve-test`; keep them encrypted in SOPS.
export MIKROTIK_READONLY_USER='api-user'
# Example per-guest socket-proxy template for pve-test (preferred):
# export DOCKER_SOCKET_PROXY_URL_TEMPLATE='http://{guest_ip}:2375'
# Legacy single-endpoint example (fallback):
# export DOCKER_SOCKET_PROXY_URL='http://10.57.3.12:2375'
# Note: legacy names `MIKROTIK_USER` / `MIKROTIK_PASSWORD` are still accepted
# as explicit compatibility fallbacks only; prefer the `MIKROTIK_READONLY_*` names.

# Target selection (test)
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_VAR_proxmox_node='pve-test'

# Ensure Terraform-era TF_VAR_pm_api_token_id prefers the readonly token id
# when available, falling back to the legacy token id for compatibility.
export TF_VAR_pm_api_token_id="${PROXMOX_READONLY_TOKEN_ID:-${PROXMOX_TOKEN_ID:-}}"

export TF_WORKSPACE='pve-test'

# Optional service endpoint overrides for pve-test can go here.
# Keep LAB_IP_*, LAB_GW_*, and LAB_SUBNET_* values non-secret.
