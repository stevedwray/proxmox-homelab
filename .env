# Non-secret environment configuration for this homelab environment.
# Secrets are injected automatically by ./with-secrets (reads terraform/secrets.common.enc.yaml).
#
# Usage:
#   source .env && somecommand          # for non-secret env vars only
#   ./with-secrets somecommand          # injects .env + SOPS secrets together
#
# For pve-test-vm environment overrides, create .env.pve-test-vm (gitignored).

# ----------------------------------------------------------------
# Proxmox Host
# ----------------------------------------------------------------
export PROXMOX_HOST='pve-test-vm.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'

# ----------------------------------------------------------------
# Terraform Variables
# ----------------------------------------------------------------
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_node=pve-test-vm
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_WORKSPACE=default
export TF_VAR_domain='gibbsgreatly.xyz'
export TF_VAR_ip_address='192.168.1.40'
export TF_VAR_hostname='management-stack'

# ----------------------------------------------------------------
# Ansible Configuration
# ----------------------------------------------------------------
export ANSIBLE_PRIVATE_KEY_FILE='~/.ssh/id_ed25519'
export ANSIBLE_HOST_KEY_CHECKING=False

# ----------------------------------------------------------------
# Service Endpoints
# ----------------------------------------------------------------
export HARBOR_HOSTNAME='harbor.lab.gibbsgreatly.xyz'
export LAB_BASE_DOMAIN='lab.gibbsgreatly.xyz'               # Base internal lab domain used by stack ingress FQDNs
export LAB_DOMAIN="${LAB_BASE_DOMAIN}"
export LAB_FQDN_TRAEFIK="traefik.${LAB_DOMAIN}"
export LAB_FQDN_AUTHENTIK="authentik.${LAB_DOMAIN}"
export LAB_FQDN_AUTHENTIK_INTERNAL="authentik-int.${LAB_DOMAIN}"
export LAB_FQDN_PORTAINER="portainer.${LAB_DOMAIN}"
export LAB_FQDN_HARBOR="harbor.${LAB_DOMAIN}"
export LAB_FQDN_GRAFANA="grafana.${LAB_DOMAIN}"
export LAB_FQDN_NETBOX="netbox.${LAB_DOMAIN}"
export MIKROTIK_HOST='192.168.1.1'
export MIKROTIK_PORT=443
export MIKROTIK_USER='api-user'

# ----------------------------------------------------------------
# Tooling
# ----------------------------------------------------------------
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
export AUTHENTIK_EXTRA_CA="${SCRIPT_DIR:-$HOME/git/proxmox-homelab}/certs/homelab-root.crt"
export HARBOR_OIDC_PROVIDER_NAME='authentik'
export HARBOR_OIDC_ENDPOINT='https://authentik.lab.gibbsgreatly.xyz/application/o/edge-harbor-stack-harbor/'
export HARBOR_OIDC_CLIENT_ID='harbor'
export OPENWEBUI_OIDC_CLIENT_ID='openwebui'
export HARBOR_OIDC_GROUPS_CLAIM='groups'
export HARBOR_OIDC_ADMIN_GROUP='homelab-admins'
export HARBOR_OIDC_GROUP_FILTER='^harbor-.*'
export HARBOR_OIDC_SCOPE='openid,profile,email,offline_access,groups'
export HARBOR_OIDC_USER_CLAIM='preferred_username'
export HARBOR_OIDC_VERIFY_CERT=false
export HARBOR_OIDC_AUTO_ONBOARD=true
export HARBOR_OIDC_LOGOUT=true
export HARBOR_OIDC_PRIMARY_AUTH_MODE=true
export GRAFANA_OAUTH_SCOPES='openid profile email groups'
export GRAFANA_OAUTH_ROLE_ATTRIBUTE_PATH="contains(groups[*], 'homelab-admins') && 'GrafanaAdmin' || 'Viewer'"
export GRAFANA_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true

# ----------------------------------------------------------------
# Lab Service IPs and Gateways (from refactor commit ff19e51)
# ----------------------------------------------------------------
export LAB_IP_AUTHENTIK='192.168.20.10'                         # Authentik service IPv4 for direct health and API probes
export LAB_IP_STEP_CA='192.168.20.11'                           # step-ca service IPv4 for direct ACME probes
export LAB_IP_MONITORING='192.168.20.12'                        # Monitoring service IPv4 for direct VictoriaMetrics probes
export LAB_IP_GRAYLOG='192.168.20.14'                           # Graylog pilot service IPv4 for direct API probes
export LAB_IP_DNS='192.168.20.13'                               # CoreDNS service IPv4 for authoritative DNS probes
export LAB_IP_PORTAINER='192.168.20.20'                         # Portainer service IPv4 for direct API probes
export LAB_IP_PROXY='192.168.30.10'                             # Traefik ingress IPv4 for HTTPS route probes
export LAB_IP_HARBOR='192.168.40.10'                            # Harbor service IPv4 for Docker registry consumers
export LAB_IP_APT_CACHER='192.168.40.11'                        # apt-cacher service IPv4 for package proxy consumers
export LAB_IP_NETBOX='192.168.40.12'                            # NetBox service IPv4 for direct probes
export LAB_IP_CI_RUNNER='192.168.10.63'                         # CI runner service IPv4
export LAB_IP_PENTAGI='192.168.70.10'                           # pentagi-stack service IPv4 (pentest_seg VLAN 70); pve-test-vm's own instance uses .110 (base+100 convention)
export LAB_IP_GREENBONE='192.168.70.11'                         # greenbone-stack (GVM/OpenVAS) service IPv4 (pentest_seg VLAN 70); pve-test-vm's own instance uses .111 (base+100 convention)
export LAB_IP_LLM_GPU='192.168.1.8'                             # framework.gibbsgreatly.xyz, bare-metal Ubuntu (ai_seg VLAN retired, see docs/framework-ubuntu/plan.md)
export LAB_IP_COMFYUI='192.168.1.8'                             # framework.gibbsgreatly.xyz, bare-metal Ubuntu (ai_seg VLAN retired, see docs/framework-ubuntu/plan.md)
export LAB_IP_AI_SERVICES='192.168.1.8'                         # ai-services-stack (OpenWebUI+SearXNG) service IPv4 (Framework bare metal)
export LAB_IP_FRAMEWORK='192.168.1.8'                           # framework.gibbsgreatly.xyz host-level IPv4, for node_exporter/cadvisor scrape targets (docs/framework-ubuntu/platform-integration-plan.md) -- same box as the three vars above, which are the older per-service-era names
export FRAMEWORK_HOST_IP='192.168.1.8'                          # ansible/inventory/inventory.yml's framework group reads this for ansible_host -- without it, ansible_host defaults to the FQDN string, so node_exporter's step-ca cert gets no IP SAN and IP-based scraping fails TLS verification (found live 2026-07-25)
export LAB_GW_BUILD='192.168.10.1'                              # build_seg gateway IPv4
export LAB_GW_MGMT='192.168.20.1'                               # mgmt_seg gateway IPv4
export LAB_GW_EDGE='192.168.30.1'                               # edge_seg gateway IPv4
export LAB_GW_INFRA='192.168.40.1'                              # infra_seg gateway IPv4
export LAB_GW_AI='192.168.50.1'                                 # ai_seg gateway IPv4 (pve-framework, VLAN 50)
export LAB_GW_PENTEST='192.168.70.1'                            # pentest_seg gateway IPv4 (VLAN 70)
export LAB_SUBNET_BUILD_CIDR='192.168.10.0/24'                  # build_seg subnet CIDR
export LAB_SUBNET_MGMT_CIDR='192.168.20.0/24'                   # mgmt_seg subnet CIDR
export LAB_SUBNET_EDGE_CIDR='192.168.30.0/24'                   # edge_seg subnet CIDR
export LAB_SUBNET_INFRA_CIDR='192.168.40.0/24'                  # infra_seg subnet CIDR
export LAB_SUBNET_AI_CIDR='192.168.50.0/24'                     # ai_seg subnet CIDR (pve-framework, VLAN 50)
export LAB_SUBNET_PENTEST_CIDR='192.168.70.0/24'                # pentest_seg subnet CIDR (VLAN 70)
export COREDNS_LOOPBACK_IP='127.0.0.1'                        # CoreDNS local probe endpoint inside dns-stack
export TRAEFIK_DNS_RESOLVER_PRIMARY='1.1.1.1:53'              # Traefik ACME DNS challenge resolver 1
export TRAEFIK_DNS_RESOLVER_SECONDARY='8.8.8.8:53'            # Traefik ACME DNS challenge resolver 2

