# pve-test environment overrides — gitignored, never committed.
# Sourced by with-secrets when PVE_ENV=pve-test is set.
#
# The automation@pve!terraform token secret is shared between pve and pve-test
# (same SOPS secret). Only the API endpoint and node name differ.

export PROXMOX_HOST='pve-test.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'

export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_VAR_proxmox_node=pve-test
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"

# Extra CA cert for Authentik API TLS verification.
# Authentik's cert is signed by the homelab step-ca; this tells Python to trust it
# in addition to the system CA store. Path is relative to the repo root.
export AUTHENTIK_EXTRA_CA="${SCRIPT_DIR:-$HOME/git/proxmox-homelab}/certs/homelab-root.crt"
