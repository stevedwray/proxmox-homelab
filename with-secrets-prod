#!/bin/bash
# with-secrets-prod — run a command with production secrets and strict access controls.
#
# This wrapper enforces production credential controls:
# - loads shared non-secret config plus production overrides
# - loads production secrets ONLY (never dev secrets)
# - enforces pve environment targeting
# - uses a conservative read-only allowlist
# - blocks mutating or ambiguous commands unless explicit operator approval is present
# - records the approved task name for mutating commands
#
# Read-only commands (allowed):
#   ./with-secrets-prod pct list
#   ./with-secrets-prod terraform plan
#   ./with-secrets-prod pvesh get /version
#
# Mutating commands (requires approval):
#   - terragrunt apply (blocked without TASK_APPROVAL)
#   - pct destroy, pct set, etc. (blocked without TASK_APPROVAL)
#   - ansible-playbook (blocked without TASK_APPROVAL)
#
# To acknowledge an approved mutating task, set:
#   export TASK_APPROVAL="task-name-from-docs"
#   ./with-secrets-prod <mutating-command>
#
# Usage:
#   # Read-only (no approval needed)
#   ./with-secrets-prod pct list
#   ./with-secrets-prod terraform plan
#
#   # Mutating (requires explicit approval)
#   export TASK_APPROVAL="01-credential-controls"
#   ./with-secrets-prod terragrunt apply
#
# The age private key is read from ~/.config/sops/age/keys.txt automatically.
# Ensure the key exists and is mode 0600 before running this script.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Base (shared) secrets and production overlay
BASE_SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.enc.yaml"
PROD_SECRETS_FILE="${SCRIPT_DIR}/terraform/secrets.pve.enc.yaml"
AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
BASE_ENV_FILE="${SCRIPT_DIR}/.env"
PROD_ENV_FILE="${SCRIPT_DIR}/.env.pve"

if [[ ! -f "${AGE_KEY_FILE}" ]]; then
    echo "ERROR: age private key not found at ${AGE_KEY_FILE}" >&2
    echo "Retrieve from Bitwarden: 'proxmox-homelab age private key'" >&2
    echo "Then: mkdir -p ~/.config/sops/age && install -m 600 /dev/stdin ${AGE_KEY_FILE}" >&2
    exit 1
fi

if [[ ! -f "${PROD_SECRETS_FILE}" ]]; then
    echo "ERROR: production secrets file not found at ${PROD_SECRETS_FILE}" >&2
    echo "Production secrets must be stored separately from dev secrets." >&2
    echo "Ensure terraform/secrets.pve.enc.yaml exists and is encrypted with SOPS." >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: $(basename "${BASH_SOURCE[0]}") <command> [args...]" >&2
    exit 1
fi

# Load shared non-secret config first, then production overrides. This keeps
# pve and pve-test on the same baseline while production still uses separate
# SOPS secrets.
if [[ -f "${BASE_ENV_FILE}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${BASE_ENV_FILE}"
    set +a
fi

if [[ -f "${PROD_ENV_FILE}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${PROD_ENV_FILE}"
    set +a
fi

# Force production environment
export PVE_ENV="pve"
export TF_VAR_proxmox_node="${TF_VAR_proxmox_node:-pve}"

# Validate production targeting
if [[ "${TF_VAR_proxmox_node}" != "pve" ]]; then
    echo "ERROR: TF_VAR_proxmox_node=${TF_VAR_proxmox_node} (expected 'pve')" >&2
    echo "Production wrapper must target 'pve', not other nodes." >&2
    exit 1
fi

# Guard against cross-environment LAB_DOMAIN contamination. If LAB_DOMAIN is
# set to a test-environment value the shell inherited from a prior pve-test-vm
# session, an Ansible provision would issue step-ca certs for the wrong domain
# on production hosts. .env.pve must declare LAB_DOMAIN=lab.gibbsgreatly.xyz
# explicitly so this sourcing order: .env → .env.pve always wins.
if [[ "${LAB_DOMAIN:-}" =~ ^(test\.gibbsgreatly\.xyz|.*\.test\.gibbsgreatly\.xyz)$ ]]; then
    echo "ERROR: LAB_DOMAIN='${LAB_DOMAIN}' is a test-environment domain but this is the pve (production) wrapper." >&2
    echo "Shell env is contaminated from a prior pve-test-vm session." >&2
    echo "Fix: ensure .env.pve explicitly sets LAB_DOMAIN=lab.gibbsgreatly.xyz" >&2
    exit 1
fi

normalize_lab_tfvars() {
    local var_name value ref_name ref_value tf_var_name
    local placeholder_pattern='^\$\{([A-Z0-9_]+)\}$'

    for var_name in $(compgen -A variable LAB_); do
        value="${!var_name}"
        [[ -n "${value}" ]] || continue
        tf_var_name="TF_VAR_${var_name,,}"
        if [[ -z "${!tf_var_name-}" ]]; then
            export "${tf_var_name}=${value}"
        fi
    done

    for var_name in $(compgen -A variable TF_VAR_lab_); do
        value="${!var_name}"
        if [[ "${value}" =~ ${placeholder_pattern} ]]; then
            ref_name="${BASH_REMATCH[1]}"
            ref_value="${!ref_name-}"
            if [[ "${ref_name}" == LAB_* && -n "${ref_value}" ]]; then
                export "${var_name}=${ref_value}"
            fi
        fi
    done
}

# Command classification: determine if the command is explicitly allowed read-only
# or must be treated as mutating/approval-required.
classify_command() {
    local cmd="$1"
    shift

    case "${cmd}" in
        pct)
            if [[ "${1:-}" == "list" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        qm)
            if [[ "${1:-}" == "list" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        pvesm)
            if [[ "${1:-}" == "status" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        pvesh)
            if [[ "${1:-}" == "get" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        terraform)
            if [[ "${1:-}" == "plan" ]] || [[ "${1:-}" == "validate" ]] || [[ "${1:-}" == "version" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        terragrunt)
            if [[ "${1:-}" == "plan" ]] || [[ "${1:-}" == "validate" ]] || [[ "${1:-}" == "show" ]] || [[ "${1:-}" == "output" ]]; then
                echo "read-only"
                return 0
            fi
            ;;
        dig|ping|ansible-inventory|printenv|python3)
            echo "read-only"
            return 0
            ;;
    esac

    echo "mutating"
    return 0
}

# Determine if this is a mutating operation
FULL_CMD="${*}"
CMD_CLASS="$(classify_command "$(basename "$1")" "${@:2}")"

# Block mutating commands without explicit approval
if [[ "${CMD_CLASS}" == "mutating" ]]; then
    if [[ -z "${TASK_APPROVAL:-}" ]]; then
        echo "ERROR: Mutating command requires explicit operator approval" >&2
        echo "" >&2
        echo "This command would alter production state:" >&2
        echo "  ${FULL_CMD}" >&2
        echo "" >&2
        echo "To proceed, you must:" >&2
        echo "  1. Review the preflight summary in the chat session" >&2
        echo "  2. Explicitly approve in chat (e.g., 'proceed with task XYZ')" >&2
        echo "  3. Set the approval environment variable to acknowledge that approved task:" >&2
        echo "     export TASK_APPROVAL=\"<task-name-from-docs>\"" >&2
        echo "  4. Run the command again" >&2
        echo "" >&2
        echo "Note: this wrapper cannot verify chat history on its own; it relies on" >&2
        echo "the operator to set TASK_APPROVAL only after chat approval." >&2
        echo "" >&2
        echo "Example:" >&2
        echo "  export TASK_APPROVAL=\"01-credential-controls\"" >&2
        echo "  ${SCRIPT_DIR}/with-secrets-prod ${FULL_CMD}" >&2
        exit 1
    fi

    echo "=== PRODUCTION MUTATION APPROVED ===" >&2
    echo "Task: ${TASK_APPROVAL}" >&2
    echo "Command: ${FULL_CMD}" >&2
    echo "" >&2
fi

normalize_lab_tfvars

# Load production secrets overlaying the base (dev) secrets, then execute the command.
# Safer strategy: decrypt both SOPS files to JSON, convert to shell `export` lines
# (without writing plaintext to disk) and `source` them in-order so prod values
# override base values. This avoids tricky nested `sops exec-env` parsing.
if [[ -f "${BASE_SECRETS_FILE}" ]]; then
    exec env SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" bash "${SCRIPT_DIR}/scripts/merge-sops-env.sh" "${BASE_SECRETS_FILE}" "${PROD_SECRETS_FILE}" -- "$@"
else
    exec env SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" bash "${SCRIPT_DIR}/scripts/merge-sops-env.sh" "${PROD_SECRETS_FILE}" -- "$@"
fi
