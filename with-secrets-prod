#!/bin/bash
# with-secrets-prod — production wrapper for the "pve" Proxmox node.
#
# Thin entrypoint: all the actual logic (secrets loading, command
# classification, approval gating) lives in scripts/with-secrets-prod-lib.sh,
# shared by every per-node production wrapper so adding a new production
# node never means copy-pasting this file. See
# docs/framework-integration/decisions.md Decision 6 for why.
#
# For the Framework Desktop production node, use ./with-secrets-prod-framework.
#
# Read-only commands (allowed):
#   ./with-secrets-prod pct list
#   ./with-secrets-prod terraform plan
#   ./with-secrets-prod pvesh get /version
#
# Mutating commands (requires approval):
#   export TASK_APPROVAL="task-name-from-docs"
#   ./with-secrets-prod terragrunt apply
#
# The age private key is read from ~/.config/sops/age/keys.txt automatically.
# Ensure the key exists and is mode 0600 before running this script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="${SCRIPT_DIR}"
export PVE_PROD_NODE="pve"

exec "${SCRIPT_DIR}/scripts/with-secrets-prod-lib.sh" "$@"
