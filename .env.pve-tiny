# pve-tiny production non-secret overlay.
#
# with-secrets-prod-tiny sources the shared .env baseline first, then this
# file. Keep this file limited to production deltas and values that are
# genuinely pve-tiny-specific. Secrets live in
# terraform/secrets.pve-tiny.enc.yaml (created once host bootstrap issues
# this node a real Terraform API token — it does not exist yet until that
# run happens).
#
# NOTE: this file matches the shape of .env.pve / .env.pve-framework, which
# are tracked in git despite the repo's .gitignore having a blanket
# `.env.*` rule — that rule predates these files and does not retroactively
# untrack them. This file needs the same treatment:
# `git add -f .env.pve-tiny` the first time it's committed. Flagged in
# docs/framework-integration/decisions.md Decision 6 as a known rough edge
# in the current secrets/env model.

export PVE_ENV='pve-tiny'

# Proxmox endpoint and Terraform target selection.
export PROXMOX_HOST='pve-tiny.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_VAR_proxmox_node='pve-tiny'
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_WORKSPACE='pve-tiny'

# Lowercase template variable used by stack rendering.
export proxmox_host="${PROXMOX_HOST}"

# LAB_DOMAIN and any zone/SDN attachment are intentionally left unset for
# now. This pass (2026-09-17) is host-baseline-only: no SDN VLAN zones, no
# terraform/lxc network/storage manifests, no stacks planned yet for this
# small single-disk box. Decide reuse-pve's-domain vs. a separate domain
# when a real network/stack phase for this node starts — the same judgment
# call recorded for pve-framework in
# docs/framework-integration/decisions.md Decision 2.
