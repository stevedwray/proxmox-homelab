diff --git a/.github/workflows/validate.yml b/.github/workflows/validate.yml
index b5121253..f64a5f09 100644
--- a/.github/workflows/validate.yml
+++ b/.github/workflows/validate.yml
@@ -273,6 +273,28 @@ jobs:
             -not -path './.venv/*' \
             | xargs bandit -ll -q
 
+  sops-freeze:
+    name: SOPS secrets files are frozen
+    # No decryption happens here -- it only inspects which paths a PR changes.
+    if: github.event_name == 'pull_request'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1
+        with:
+          fetch-depth: 0
+
+      - name: Fail if a PR adds or modifies terraform/secrets.*.enc.yaml
+        env:
+          BASE_REF: ${{ github.base_ref }}
+        run: |
+          changed="$(git diff --name-only --diff-filter=AM "origin/${BASE_REF}...HEAD" -- 'terraform/secrets.*.enc.yaml')"
+          if [ -n "${changed}" ]; then
+            echo "These SOPS files are frozen since the OpenBao cutover (docs/secrets-refactor/):"
+            echo "${changed}"
+            exit 1
+          fi
+          echo "No frozen SOPS files changed."
+
   sops-decrypt-check:
     name: SOPS decrypt verification
     # Self-hosted, not ubuntu-latest -- operator policy (2026-09-07): no
diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
index 389864a8..5b456ad3 100644
--- a/.pre-commit-config.yaml
+++ b/.pre-commit-config.yaml
@@ -26,9 +26,12 @@ repos:
 
   - repo: local
     hooks:
-      - id: check-required-sops-keys
-        name: Check required SOPS keys
-        entry: bash scripts/check-required-sops-keys.sh
-        language: system
-        pass_filenames: false
-        files: ^terraform/secrets\.common\.enc\.yaml$
+      # OpenBao is authoritative since the cutover (docs/secrets-refactor/).
+      # A change to a SOPS file could only reintroduce a stale value, so any
+      # staged change to one fails. Deletions (SOPS retirement) are allowed:
+      # pre-commit does not pass deleted files to hooks.
+      - id: block-sops-secret-edits
+        name: Block edits to frozen SOPS secrets files
+        entry: "terraform/secrets.*.enc.yaml are frozen: OpenBao is authoritative. Write secrets with scripts/openbao_write.py (docs/secrets-refactor/)."
+        language: fail
+        files: ^terraform/secrets\..*\.enc\.yaml$
