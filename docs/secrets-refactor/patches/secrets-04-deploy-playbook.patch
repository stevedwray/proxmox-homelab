diff --git a/terraform/lxc/ansible/playbooks/deploy-openbao.yml b/terraform/lxc/ansible/playbooks/deploy-openbao.yml
new file mode 100644
index 00000000..d9427575
--- /dev/null
+++ b/terraform/lxc/ansible/playbooks/deploy-openbao.yml
@@ -0,0 +1,392 @@
+---
+# deploy-openbao.yml -- OpenBao secrets store on its own LXC (mgmt_seg).
+# Native upstream .deb + systemd; no Docker, no Harbor dependency, so a
+# rebuild never waits on Harbor. Design: docs/secrets-refactor/secrets-design.md.
+#
+# Safe to run before the seal-key bind mount exists: everything is installed
+# and configured, but openbao.service is only started once
+# /srv/openbao-seal/<key-id>.key is present (plan: operator block A).
+- name: Deploy OpenBao
+  hosts: all
+  become: true
+  gather_facts: false
+
+  vars:
+    openbao_version: "2.7.0"
+    openbao_deb_sha256: "7412233fef6bbe0e5093aa5461f493dd3a0f6193c8d5a5ba3a7ff475f96f34a2"
+    openbao_deb_url: "https://github.com/openbao/openbao/releases/download/v{{ openbao_version }}/openbao_{{ openbao_version }}_linux_amd64.deb"
+    openbao_ip: "{{ lookup('env', 'LAB_IP_OPENBAO') | mandatory('LAB_IP_OPENBAO env var is required') }}"
+    openbao_ui_fqdn: "{{ lookup('env', 'LAB_FQDN_OPENBAO') | mandatory('LAB_FQDN_OPENBAO env var is required') }}"
+    openbao_seal_key_id: "homelab-2026-1"
+    openbao_seal_dir: /srv/openbao-seal
+    openbao_seal_key_path: "{{ openbao_seal_dir }}/{{ openbao_seal_key_id }}.key"
+    openbao_snapshot_dir: /srv/openbao-snapshots
+    openbao_tls_dir: /etc/openbao/tls
+    openbao_tls_cert: "{{ openbao_tls_dir }}/tls.crt"
+    openbao_tls_key: "{{ openbao_tls_dir }}/tls.key"
+    openbao_root_ca: /usr/local/share/ca-certificates/homelab-root.crt
+    openbao_step_ca_url: "https://{{ lookup('env', 'LAB_IP_STEP_CA') | mandatory('LAB_IP_STEP_CA env var is required') }}"
+    openbao_step_ca_provisioner: "{{ lookup('env', 'STEP_CA_PROVISIONER_NAME') | default('homelab-admin', true) }}"
+    openbao_step_ca_provisioner_password: "{{ lookup('env', 'STEP_CA_PROVISIONER_PASSWORD') | mandatory('STEP_CA_PROVISIONER_PASSWORD env var is not set') }}"
+    # Consumed by the node_exporter role (via lxc_base): enables the textfile
+    # collector that openbao_snapshot.py writes its metrics into.
+    node_exporter_textfile_dir: /var/lib/node_exporter/textfile
+
+  roles:
+    - lxc_base
+
+  pre_tasks:
+    - name: Wait for SSH to become available after container creation
+      ansible.builtin.wait_for_connection:
+        timeout: 300
+        delay: 2
+
+    - name: Gather facts after the guest is reachable
+      ansible.builtin.setup:
+
+  tasks:
+    - name: Mask portainer-agent service (platform tier -- no agent on this host)
+      ansible.builtin.systemd:
+        name: portainer-agent.service
+        masked: true
+        enabled: false
+      failed_when: false
+
+    - name: Install OpenBao host dependencies
+      ansible.builtin.apt:
+        name:
+          - ca-certificates
+          - curl
+          - openssl
+          - python3
+        state: present
+        update_cache: true
+
+    - name: Create package cache directory
+      ansible.builtin.file:
+        path: /var/cache/openbao
+        state: directory
+        owner: root
+        group: root
+        mode: "0755"
+
+    - name: Download pinned OpenBao .deb (checksum-verified)
+      ansible.builtin.get_url:
+        url: "{{ openbao_deb_url }}"
+        dest: "/var/cache/openbao/openbao_{{ openbao_version }}_linux_amd64.deb"
+        checksum: "sha256:{{ openbao_deb_sha256 }}"
+        mode: "0644"
+        timeout: 60
+      register: openbao_deb_download
+      until: openbao_deb_download is succeeded
+      retries: 5
+      delay: 5
+
+    - name: Install OpenBao package (keep our config on upgrade)
+      ansible.builtin.apt:
+        deb: "/var/cache/openbao/openbao_{{ openbao_version }}_linux_amd64.deb"
+        dpkg_options: "force-confold,force-confdef"
+
+    - name: Create OpenBao directories
+      ansible.builtin.file:
+        path: "{{ item.path }}"
+        state: directory
+        owner: "{{ item.owner }}"
+        group: "{{ item.group }}"
+        mode: "{{ item.mode }}"
+      loop:
+        - { path: "{{ openbao_tls_dir }}", owner: openbao, group: openbao, mode: "0750" }
+        - { path: /opt/openbao/data, owner: openbao, group: openbao, mode: "0700" }
+        - { path: /var/log/openbao, owner: openbao, group: openbao, mode: "0750" }
+        - { path: /etc/openbao-snapshot, owner: root, group: root, mode: "0700" }
+
+    # ---- TLS: step-ca cert with IP + UI FQDN SANs --------------------------
+    # Issued at deploy time with the provisioner password, which is deleted
+    # again straight after. Renewal uses `step ca renew` (mTLS with the
+    # existing cert), so no step-ca secret stays on this host.
+    - name: Check current OpenBao TLS certificate
+      ansible.builtin.shell: |
+        set -euo pipefail
+        if [[ -s "{{ openbao_tls_cert }}" && -s "{{ openbao_tls_key }}" ]] \
+           && openssl x509 -checkend 1296000 -noout -in "{{ openbao_tls_cert }}" >/dev/null 2>&1; then
+          echo valid
+        else
+          echo issue
+        fi
+      args:
+        executable: /bin/bash
+      register: openbao_tls_state
+      changed_when: false
+
+    - name: Issue OpenBao TLS certificate from step-ca
+      when: openbao_tls_state.stdout == 'issue'
+      block:
+        - name: Write temporary step-ca provisioner password file
+          ansible.builtin.copy:
+            dest: /root/.openbao-step-provisioner-password
+            content: "{{ openbao_step_ca_provisioner_password }}\n"
+            owner: root
+            group: root
+            mode: "0600"
+          no_log: true
+
+        - name: Request certificate with IP and UI FQDN SANs
+          ansible.builtin.command:
+            argv:
+              - /usr/local/bin/step
+              - ca
+              - certificate
+              - "{{ openbao_ui_fqdn }}"
+              - "{{ openbao_tls_cert }}"
+              - "{{ openbao_tls_key }}"
+              - --san
+              - "{{ openbao_ui_fqdn }}"
+              - --san
+              - "{{ openbao_ip }}"
+              - --ca-url
+              - "{{ openbao_step_ca_url }}"
+              - --root
+              - "{{ openbao_root_ca }}"
+              - --provisioner
+              - "{{ openbao_step_ca_provisioner }}"
+              - --provisioner-password-file
+              - /root/.openbao-step-provisioner-password
+              - --not-after
+              - 720h
+              - --force
+          changed_when: true
+          notify: Restart openbao
+      always:
+        - name: Remove temporary step-ca provisioner password file
+          ansible.builtin.file:
+            path: /root/.openbao-step-provisioner-password
+            state: absent
+
+    - name: Set OpenBao TLS file ownership and modes
+      ansible.builtin.file:
+        path: "{{ item.path }}"
+        owner: openbao
+        group: openbao
+        mode: "{{ item.mode }}"
+      loop:
+        - { path: "{{ openbao_tls_cert }}", mode: "0644" }
+        - { path: "{{ openbao_tls_key }}", mode: "0600" }
+
+    - name: Write OpenBao TLS renewal script
+      ansible.builtin.copy:
+        dest: /usr/local/sbin/openbao-tls-renew.sh
+        owner: root
+        group: root
+        mode: "0750"
+        content: |
+          #!/bin/bash
+          # Renew the OpenBao listener cert via mTLS with the existing cert
+          # (no provisioner password needed), then SIGHUP OpenBao to reload it.
+          set -euo pipefail
+          CERT="{{ openbao_tls_cert }}"
+          KEY="{{ openbao_tls_key }}"
+          if openssl x509 -checkend 1296000 -noout -in "${CERT}" >/dev/null 2>&1; then
+            echo "openbao TLS cert valid for >15d, nothing to do"
+            exit 0
+          fi
+          /usr/local/bin/step ca renew --force \
+            --ca-url "{{ openbao_step_ca_url }}" \
+            --root "{{ openbao_root_ca }}" \
+            "${CERT}" "${KEY}"
+          chown openbao:openbao "${CERT}" "${KEY}"
+          chmod 0644 "${CERT}"
+          chmod 0600 "${KEY}"
+          systemctl reload openbao.service
+          echo "openbao TLS cert renewed and reloaded"
+
+    - name: Write OpenBao TLS renewal service and timer
+      ansible.builtin.copy:
+        dest: "/etc/systemd/system/{{ item.name }}"
+        owner: root
+        group: root
+        mode: "0644"  # nosonar: ansible:S2612 -- systemd unit files must be world-readable
+        content: "{{ item.content }}"
+      loop:
+        - name: openbao-tls-renew.service
+          content: |
+            [Unit]
+            Description=Renew OpenBao listener TLS certificate from step-ca
+            After=network-online.target
+            Wants=network-online.target
+
+            [Service]
+            Type=oneshot
+            ExecStart=/usr/local/sbin/openbao-tls-renew.sh
+        - name: openbao-tls-renew.timer
+          content: |
+            [Unit]
+            Description=Daily check/renewal of the OpenBao listener TLS certificate
+
+            [Timer]
+            OnCalendar=daily
+            RandomizedDelaySec=1h
+            Persistent=true
+
+            [Install]
+            WantedBy=timers.target
+
+    # ---- OpenBao server config -------------------------------------------
+    - name: Write OpenBao server configuration
+      ansible.builtin.copy:
+        dest: /etc/openbao/openbao.hcl
+        owner: openbao
+        group: openbao
+        mode: "0640"
+        content: |
+          # Managed by terraform/lxc/ansible/playbooks/deploy-openbao.yml -- do not edit by hand.
+          ui            = true
+          cluster_name  = "homelab"
+          api_addr      = "https://{{ openbao_ip }}:8200"
+          cluster_addr  = "https://{{ openbao_ip }}:8201"
+          disable_mlock = true
+
+          storage "raft" {
+            path    = "/opt/openbao/data"
+            node_id = "openbao-1"
+          }
+
+          listener "tcp" {
+            address         = "0.0.0.0:8200"
+            cluster_address = "0.0.0.0:8201"
+            tls_cert_file   = "{{ openbao_tls_cert }}"
+            tls_key_file    = "{{ openbao_tls_key }}"
+          }
+
+          # Static auto-unseal: 32-byte AES key on the USB stick, bind-mounted
+          # read-only from pve (design doc 7-8). The key never enters Raft data
+          # or LXC backups.
+          seal "static" {
+            current_key_id = "{{ openbao_seal_key_id }}"
+            current_key    = "file://{{ openbao_seal_key_path }}"
+          }
+      notify: Restart openbao
+
+    - name: Write logrotate config for the OpenBao audit log
+      ansible.builtin.copy:
+        dest: /etc/logrotate.d/openbao
+        owner: root
+        group: root
+        mode: "0644"
+        content: |
+          /var/log/openbao/audit.log {
+            daily
+            rotate 30
+            compress
+            delaycompress
+            missingok
+            notifempty
+            create 0640 openbao openbao
+            postrotate
+              systemctl reload openbao.service >/dev/null 2>&1 || true
+            endscript
+          }
+
+    # ---- Snapshots (design doc 27.0) -------------------------------------
+    - name: Install snapshot script
+      ansible.builtin.copy:
+        src: "{{ playbook_dir }}/../files/openbao/openbao_snapshot.py"
+        dest: /usr/local/sbin/openbao_snapshot.py
+        owner: root
+        group: root
+        mode: "0750"
+
+    - name: Write snapshot service template and nightly timer
+      ansible.builtin.copy:
+        dest: "/etc/systemd/system/{{ item.name }}"
+        owner: root
+        group: root
+        mode: "0644"  # nosonar: ansible:S2612 -- systemd unit files must be world-readable
+        content: "{{ item.content }}"
+      loop:
+        - name: openbao-snapshot@.service
+          content: |
+            [Unit]
+            Description=OpenBao Raft snapshot (%i) to the NAS
+            After=openbao.service network-online.target
+            Wants=network-online.target
+
+            [Service]
+            Type=oneshot
+            ExecStart=/usr/bin/python3 /usr/local/sbin/openbao_snapshot.py %i
+        - name: openbao-snapshot-nightly.timer
+          content: |
+            [Unit]
+            Description=Nightly OpenBao Raft snapshot
+
+            [Timer]
+            OnCalendar=*-*-* 03:30:00
+            Persistent=true
+            Unit=openbao-snapshot@nightly.service
+
+            [Install]
+            WantedBy=timers.target
+
+    - name: Reload systemd units
+      ansible.builtin.systemd:
+        daemon_reload: true
+
+    - name: Enable timers
+      ansible.builtin.systemd:
+        name: "{{ item }}"
+        enabled: true
+        state: started
+      loop:
+        - openbao-tls-renew.timer
+        - openbao-snapshot-nightly.timer
+
+    # ---- Start only when the seal key is present --------------------------
+    - name: Check for the seal key (bind-mounted from the USB on pve)
+      ansible.builtin.stat:
+        path: "{{ openbao_seal_key_path }}"
+      register: openbao_seal_key
+
+    - name: Enable OpenBao service
+      ansible.builtin.systemd:
+        name: openbao.service
+        enabled: true
+
+    - name: Start OpenBao
+      ansible.builtin.systemd:
+        name: openbao.service
+        state: started
+      when: openbao_seal_key.stat.exists
+
+    - name: Report missing seal key (OpenBao left stopped)
+      ansible.builtin.debug:
+        msg: >-
+          {{ openbao_seal_key_path }} is not present, so openbao.service was
+          not started. Complete operator block A (USB key + pct set bind
+          mounts) and re-run provision.sh for openbao-stack.
+      when: not openbao_seal_key.stat.exists
+
+    - name: Wait for the OpenBao API
+      ansible.builtin.wait_for:
+        host: "{{ openbao_ip }}"
+        port: 8200
+        timeout: 60
+      when: openbao_seal_key.stat.exists
+
+    - name: Read OpenBao health (initialized/sealed state)
+      ansible.builtin.uri:
+        url: "https://{{ openbao_ip }}:8200/v1/sys/health?uninitcode=200&sealedcode=200&standbyok=true"
+        ca_path: "{{ openbao_root_ca }}"
+        return_content: true
+      register: openbao_health
+      when: openbao_seal_key.stat.exists
+
+    - name: Report OpenBao health
+      ansible.builtin.debug:
+        msg: "initialized={{ openbao_health.json.initialized }} sealed={{ openbao_health.json.sealed }} version={{ openbao_health.json.version }}"
+      when: openbao_seal_key.stat.exists
+
+  handlers:
+    - name: Restart openbao
+      ansible.builtin.systemd:
+        name: openbao.service
+        state: restarted
+      when: openbao_seal_key.stat.exists | default(false)
