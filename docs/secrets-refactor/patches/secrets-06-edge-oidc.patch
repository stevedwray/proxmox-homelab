diff --git a/terraform/lxc/stacks/openbao-stack/edge.yaml b/terraform/lxc/stacks/openbao-stack/edge.yaml
new file mode 100644
index 00000000..b4e63b1d
--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/edge.yaml
@@ -0,0 +1,23 @@
+apiVersion: homelab.gibbsgreatly.xyz/v1alpha1
+kind: EdgeManifest
+metadata:
+  name: openbao-edge
+  stack: openbao-stack
+  annotations:
+    repo.auth.oidc.client_id_env: OPENBAO_OIDC_CLIENT_ID
+    repo.auth.oidc.client_secret_env: OPENBAO_OIDC_CLIENT_SECRET
+spec:
+  routes:
+    - name: openbao
+      host: openbao.${LAB_DOMAIN}
+      backend:
+        type: url
+        url: https://${LAB_IP_OPENBAO}:8200
+      dns:
+        enabled: true
+        target: ${LAB_IP_PROXY}
+        ttl: 5m
+      tls:
+        resolver: letsencrypt
+      auth:
+        mode: oidc
