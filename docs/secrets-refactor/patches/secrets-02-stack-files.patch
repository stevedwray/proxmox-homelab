--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/policies/ci-netbox-populate.hcl
@@ -0,0 +1,17 @@
+# GitHub Actions netbox-populate workflow (auth/jwt-github). Exactly the
+# entries in the manifest's ci-netbox-populate profile, read-only.
+path "kv/data/services/mikrotik" {
+  capabilities = ["read"]
+}
+
+path "kv/data/services/netbox" {
+  capabilities = ["read"]
+}
+
+path "kv/data/services/portainer" {
+  capabilities = ["read"]
+}
+
+path "kv/data/hosts/pve" {
+  capabilities = ["read"]
+}
diff --git a/terraform/lxc/stacks/openbao-stack/policies/deploy-common.hcl b/terraform/lxc/stacks/openbao-stack/policies/deploy-common.hcl
new file mode 100644
index 00000000..9c9e6ffd
--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/policies/deploy-common.hcl
@@ -0,0 +1,9 @@
+# Read-only deploy access to service and shared entries (every deploy-* AppRole).
+# No create/update/patch/delete: a deploy can never change a secret value.
+path "kv/data/services/*" {
+  capabilities = ["read"]
+}
+
+path "kv/data/shared/*" {
+  capabilities = ["read"]
+}
diff --git a/terraform/lxc/stacks/openbao-stack/policies/openbao-admin.hcl b/terraform/lxc/stacks/openbao-stack/policies/openbao-admin.hcl
new file mode 100644
index 00000000..2ffabf4f
--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/policies/openbao-admin.hcl
@@ -0,0 +1,6 @@
+# Human administrators: Authentik group homelab-admins via OIDC (auth/oidc,
+# role homelab-admin), and break-glass tokens from generate-root.
+# Never attached to any machine identity.
+path "*" {
+  capabilities = ["create", "read", "update", "patch", "delete", "list", "sudo"]
+}
diff --git a/terraform/lxc/stacks/openbao-stack/policies/snapshot.hcl b/terraform/lxc/stacks/openbao-stack/policies/snapshot.hcl
new file mode 100644
index 00000000..b5f1f82c
--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/policies/snapshot.hcl
@@ -0,0 +1,4 @@
+# Raft snapshot download only (AppRole "snapshot", credentials on the OpenBao LXC).
+path "sys/storage/raft/snapshot" {
+  capabilities = ["read", "sudo"]
+}
diff --git a/terraform/lxc/stacks/openbao-stack/stack.yaml b/terraform/lxc/stacks/openbao-stack/stack.yaml
new file mode 100644
index 00000000..eace9a86
--- /dev/null
+++ b/terraform/lxc/stacks/openbao-stack/stack.yaml
@@ -0,0 +1,46 @@
+# OpenBao secrets store -- mgmt_seg zone. Native .deb + systemd, no Docker.
+# Design: docs/secrets-refactor/secrets-design.md. Plan: docs/secrets-refactor/plan.md.
+hostname: openbao
+ip_address: "192.168.20.16/24"
+gateway: "${lab_gw_mgmt}"
+dns_server: "${lab_gw_mgmt}"
+vmid: 20016
+cores: 1
+memory: 1024
+swap: 512
+rootfs_size: 8
+storage_profile: platform-default
+template_name: "debian-13.1-2-docker-template.tar.gz"
+tags:
+  - openbao
+  - secrets
+  - infrastructure
+depends_on:
+  - apt-cacher-stack
+  - step-ca-stack
+provides:
+  - service: openbao-api
+    port: 8200
+    protocol: tcp
+
+network:
+  zone: mgmt_seg
+
+ansible_playbook: "deploy-openbao"
+deployment_tier: platform
+portainer_agent: false
+
+portainer_server_ip: "${lab_ip_portainer}"
+apt_cacher_host: "${lab_ip_apt_cacher}"
+
+# Documentation/consistency only -- NOT applied by Terraform. Bind mounts are
+# root@pam-only on Proxmox, so these are applied by the operator with
+# `pct set` over root SSH (docs/secrets-refactor/plan.md, operator block A).
+# mp0: USB seal key, read-only. mp1: NAS snapshot directory (pve's NFS mount).
+# Proxmox vzdump never includes bind mounts, which is what keeps the seal key
+# out of LXC backups (design doc 8.1).
+host_bind_mounts:
+  - host_path: /mnt/openbao-seal
+    lxc_path: /srv/openbao-seal
+  - host_path: /mnt/nas-backup/openbao-snapshots
+    lxc_path: /srv/openbao-snapshots
