# Local production non-secret overlay (gitignored)
# Task 02 operational target model: production environment selection only.
# Keep secrets out of this file; secrets live in terraform/secrets.pve.enc.yaml.

export PVE_ENV='pve'

# Proxmox endpoint selection (production)
export PROXMOX_HOST='pve.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'

# Target selection (production)
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_VAR_proxmox_node='pve'
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_WORKSPACE='pve'

# Production domain (both Proxmox name and Terraform rendering)
export TF_VAR_domain='gibbsgreatly.xyz'

# Production non-secret network/domain values known from repo baseline.
export LAB_GW_BUILD='192.168.10.1'
export LAB_GW_MGMT='192.168.20.1'
export LAB_GW_EDGE='192.168.30.1'
export LAB_GW_INFRA='192.168.40.1'
export LAB_SUBNET_BUILD_CIDR='192.168.10.0/24'
export LAB_SUBNET_MGMT_CIDR='192.168.20.0/24'
export LAB_SUBNET_EDGE_CIDR='192.168.30.0/24'
export LAB_SUBNET_INFRA_CIDR='192.168.40.0/24'
export LAB_DOMAIN='lab.gibbsgreatly.xyz'

# Canonical lab FQDNs used by active platform playbooks.
# Most playbooks can derive these from LAB_DOMAIN, but keep them explicit here so
# production does not depend on hidden defaults.
export LAB_FQDN_TRAEFIK="traefik.${LAB_DOMAIN}"
export LAB_FQDN_AUTHENTIK="authentik.${LAB_DOMAIN}"
export LAB_FQDN_AUTHENTIK_INTERNAL="authentik-int.${LAB_DOMAIN}"
export LAB_FQDN_PORTAINER="portainer.${LAB_DOMAIN}"
export LAB_FQDN_HARBOR="harbor.${LAB_DOMAIN}"
export LAB_FQDN_GRAFANA="grafana.${LAB_DOMAIN}"
export LAB_FQDN_NETBOX="netbox.${LAB_DOMAIN}"

# Harbor non-secret runtime settings consumed directly by the Harbor playbook.
# Keep these in the production overlay because ./with-secrets-prod does not
# source the base .env file.
export HARBOR_HOSTNAME="${LAB_FQDN_HARBOR}"
export HARBOR_OIDC_PROVIDER_NAME='authentik'
export HARBOR_OIDC_ENDPOINT="https://${LAB_FQDN_AUTHENTIK}/application/o/edge-harbor-stack-harbor/"
export HARBOR_OIDC_CLIENT_ID='harbor'
export HARBOR_OIDC_GROUPS_CLAIM='groups'
export HARBOR_OIDC_ADMIN_GROUP='homelab-admins'
export HARBOR_OIDC_GROUP_FILTER='^harbor-.*'
export HARBOR_OIDC_SCOPE='openid,profile,email,offline_access,groups'
export HARBOR_OIDC_USER_CLAIM='preferred_username'
export HARBOR_OIDC_VERIFY_CERT=false
export HARBOR_OIDC_AUTO_ONBOARD=true
export HARBOR_OIDC_LOGOUT=true
export HARBOR_OIDC_PRIMARY_AUTH_MODE=true

# Grafana OIDC tuning for parity with pve-test; enables groups-based RBAC.
# If unset, playbook defaults to username-based role assignment.
export GRAFANA_OAUTH_SCOPES='openid profile email groups'
export GRAFANA_OAUTH_ROLE_ATTRIBUTE_PATH="contains(groups[*], 'homelab-admins') && 'GrafanaAdmin' || 'Viewer'"
export GRAFANA_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true

# Optional operator identity values consumed by some active playbooks.
# Defaults exist in the playbooks, but keeping them explicit here makes the
# production non-secret surface easier to reason about.
export LAB_ADMIN_USERNAME='steve'
export LAB_ADMIN_EMAIL="${LAB_ADMIN_USERNAME}@${LAB_DOMAIN}"

# Operator-confirmed production service IP allocations (from design baseline).
# Addresses are within the segmented production network design:
#   build_seg (VLAN 10):  192.168.10.0/24
#   mgmt_seg  (VLAN 20):  192.168.20.0/24
#   edge_seg  (VLAN 30):  192.168.30.0/24
#   infra_seg (VLAN 40):  192.168.40.0/24
export LAB_IP_AUTHENTIK='192.168.20.10'
export LAB_IP_STEP_CA='192.168.20.11'
export LAB_IP_MONITORING='192.168.20.12'
export LAB_IP_DNS='192.168.20.13'
export LAB_IP_PORTAINER='192.168.20.20'
export LAB_IP_PROXY='192.168.30.10'
export LAB_IP_HARBOR='192.168.40.10'
export LAB_IP_APT_CACHER='192.168.40.11'
export LAB_IP_NETBOX='192.168.40.12'
export LAB_IP_CI_RUNNER='192.168.10.63'

# Keep the proxy ACME DNS challenge resolvers explicit in the production
# overlay because ./with-secrets-prod does not source the base .env file.
export TRAEFIK_DNS_RESOLVER_PRIMARY='1.1.1.1:53'
export TRAEFIK_DNS_RESOLVER_SECONDARY='8.8.8.8:53'

# Terraform stack rendering consumes TF_VAR_lab_* while the active Ansible
# playbooks consume raw LAB_* env vars. Keep both surfaces explicit in .env.pve
# because ./with-secrets-prod sources this overlay only.
export TF_VAR_lab_ip_authentik="${LAB_IP_AUTHENTIK}"
export TF_VAR_lab_ip_step_ca="${LAB_IP_STEP_CA}"
export TF_VAR_lab_ip_monitoring="${LAB_IP_MONITORING}"
export TF_VAR_lab_ip_dns="${LAB_IP_DNS}"
export TF_VAR_lab_ip_portainer="${LAB_IP_PORTAINER}"
export TF_VAR_lab_ip_proxy="${LAB_IP_PROXY}"
export TF_VAR_lab_ip_harbor="${LAB_IP_HARBOR}"
export TF_VAR_lab_ip_apt_cacher="${LAB_IP_APT_CACHER}"
export TF_VAR_lab_ip_netbox="${LAB_IP_NETBOX}"
export TF_VAR_lab_ip_ci_runner="${LAB_IP_CI_RUNNER}"
export TF_VAR_lab_gw_build="${LAB_GW_BUILD}"
export TF_VAR_lab_gw_mgmt="${LAB_GW_MGMT}"
export TF_VAR_lab_gw_edge="${LAB_GW_EDGE}"
export TF_VAR_lab_gw_infra="${LAB_GW_INFRA}"
export TF_VAR_lab_subnet_build_cidr="${LAB_SUBNET_BUILD_CIDR}"
export TF_VAR_lab_subnet_mgmt_cidr="${LAB_SUBNET_MGMT_CIDR}"
export TF_VAR_lab_subnet_edge_cidr="${LAB_SUBNET_EDGE_CIDR}"
export TF_VAR_lab_subnet_infra_cidr="${LAB_SUBNET_INFRA_CIDR}"

#
# Never put passwords, API tokens, or private keys in this file.
# Secrets belong only in terraform/secrets.pve.enc.yaml.
