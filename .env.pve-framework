# pve-framework (Framework Desktop) production non-secret overlay.
#
# with-secrets-prod-framework sources the shared .env baseline first, then
# this file. Keep this file limited to production deltas and values that
# are genuinely pve-framework-specific. Secrets live in
# terraform/secrets.pve-framework.enc.yaml (created once Phase 0 of
# docs/framework-integration/plan.md issues this node a real Terraform
# API token — it does not exist yet).
#
# NOTE: this file matches the shape of .env.pve, which is tracked in git
# despite the repo's .gitignore having a blanket `.env.*` rule — that rule
# predates these files and does not retroactively untrack them. This file
# needs the same treatment: `git add -f .env.pve-framework` the first time
# it's committed. Flagged in docs/framework-integration/decisions.md
# Decision 6 as one of the rough edges in the current secrets/env model.

export PVE_ENV='pve-framework'

# Proxmox endpoint and Terraform target selection.
export PROXMOX_HOST='pve-framework.gibbsgreatly.xyz'
export PROXMOX_USER='automation@pve'
export PROXMOX_TOKEN_ID='automation@pve!terraform'
export TF_VAR_proxmox_api_url="https://${PROXMOX_HOST}:8006/api2/json"
export TF_VAR_proxmox_host="${PROXMOX_HOST}"
export TF_VAR_proxmox_node='pve-framework'
export TF_VAR_pm_api_token_id="${PROXMOX_TOKEN_ID}"
export TF_WORKSPACE='pve-framework'

# Lowercase template variable used by stack rendering.
export proxmox_host="${PROXMOX_HOST}"

# pve-framework is lab-trusted per docs/framework-integration/decisions.md
# Decision 2 — it reuses pve's existing Authentik/step-ca/Harbor/NetBox/
# Traefik instances rather than standing up its own, so it shares pve's
# domain rather than getting a separate one.
export LAB_ADMIN_USERNAME='steve'
export LAB_DOMAIN='lab.gibbsgreatly.xyz'
export LAB_ADMIN_EMAIL="${LAB_ADMIN_USERNAME}@${LAB_DOMAIN}"

